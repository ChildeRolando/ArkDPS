acceptance/recovery/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
acceptance/recovery/*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
acceptance/recovery/*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
