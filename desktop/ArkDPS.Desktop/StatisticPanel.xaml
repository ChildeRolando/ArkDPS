<UserControl x:Class="ArkDPS.Desktop.StatisticPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ArkDPS.Desktop" MinWidth="400">
 <UserControl.Resources>
  <DataTemplate x:Key="FullRow" DataType="{x:Type local:RowItem}">
   <Grid MinHeight="51" Margin="0,0,6,0" ToolTip="{Binding Tooltip}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" CornerRadius="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True">
      <Grid><TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Opacity="{Binding PortraitOpacity}" Stretch="UniformToFill"/></Grid>
     </Border>
     <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock Text="{Binding Presence}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,1,0,0"/>
     </StackPanel>
    </StackPanel>
    <Border Grid.Column="2" Background="Transparent" ToolTip="{Binding BarTooltip}" Margin="4,0,10,0">
     <local:ContributionBar Data="{Binding Entry}" Height="7" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Grid.Column="3" Text="{Binding Total}" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="4" Text="{Binding Rate}" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="5" Text="{Binding Share}" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="HudRow" DataType="{x:Type local:RowItem}">
   <Grid MinHeight="32" Margin="0,0,10,0" ToolTip="{Binding Tooltip}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="26"/><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="44"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"/>
    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True">
     <Grid><TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Ink}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Opacity="{Binding PortraitOpacity}" Stretch="UniformToFill"/></Grid>
    </Border>
    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="4,0,4,0"/>
    <Border Grid.Column="3" Background="Transparent" ToolTip="{Binding BarTooltip}" Margin="2,0,6,0">
     <local:ContributionBar Data="{Binding Entry}" Height="5" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Grid.Column="4" Text="{Binding Total}" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="5" Text="{Binding Rate}" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="6" Text="{Binding Share}" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <Style x:Key="EffectiveSwitch" TargetType="ToggleButton">
   <Setter Property="Width" Value="150"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="track" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="2">
     <Grid>
      <Border x:Name="thumb" Width="71" CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource Accent}" HorizontalAlignment="Right"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock x:Name="effective" Text="有效伤害" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
       <TextBlock x:Name="overflow" Grid.Column="1" Text="溢出总伤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
      </Grid>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Left"/>
      <Setter TargetName="effective" Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter TargetName="overflow" Property="Foreground" Value="{DynamicResource Muted}"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Margin="0,0,12,14">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <DockPanel x:Name="TitleBar" Margin="14,10,12,8">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="HudClose" Content="×" Click="CloseHud" Padding="6,1" FontSize="19" MinWidth="28" Visibility="Collapsed" ToolTip="关闭 HUD" Background="Transparent" BorderBrush="{DynamicResource Line}"/>
     <WrapPanel x:Name="Actions" VerticalAlignment="Center">
      <Button Content="HUD" Click="OpenHud" ToolTip="从本面板打开单屏 HUD" Padding="10,5" FontSize="13" Background="{DynamicResource Inset}"/>
      <Button Content="复制" Click="Duplicate" Padding="9,5" FontSize="13" Background="{DynamicResource Inset}"/>
      <Button x:Name="DeleteButton" Content="删除" Click="Delete" Padding="9,5" FontSize="13" Background="{DynamicResource Inset}"/>
     </WrapPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="3" Height="18" Background="{DynamicResource Accent}" CornerRadius="1" Margin="0,0,8,0"/>
     <StackPanel><TextBlock x:Name="Heading" Style="{StaticResource CardTitle}" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="PanelKind" Text="LIVE PANEL" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/></StackPanel>
    </StackPanel>
   </DockPanel>

   <WrapPanel x:Name="Selectors" Grid.Row="1" Margin="14,0,14,8">
    <StackPanel Margin="0,0,8,0"><TextBlock Text="统计类别" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Category" Width="88" SelectionChanged="ConfigurationChanged" AutomationProperties.Name="统计类别">
     <ComboBoxItem Content="伤害" Tag="damage"/><ComboBoxItem Content="治疗" Tag="healing"/><ComboBoxItem Content="有效护盾" Tag="shield"/>
    </ComboBox></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="排行依据" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Ranking" Width="96" SelectionChanged="ConfigurationChanged" AutomationProperties.Name="排行口径">
     <ComboBoxItem Content="总伤" Tag="total"/><ComboBoxItem Content="DPS" Tag="dps"/>
    </ComboBox></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="DPS算法" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Rate" Width="104" SelectionChanged="ConfigurationChanged" AutomationProperties.Name="DPS算法">
     <ComboBoxItem Content="近 5 秒" Tag="recent_5s"/><ComboBoxItem Content="接敌" Tag="engagement"/><ComboBoxItem Content="全周期DPS" Tag="full_cycle"/>
    </ComboBox></StackPanel>
   </WrapPanel>

   <Border x:Name="RateNoticePanel" Grid.Row="2" Visibility="Collapsed" Margin="14,0,14,8" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="10,7">
    <DockPanel><Button x:Name="RateAction" DockPanel.Dock="Right" Click="RateActionClicked" Padding="9,4" VerticalAlignment="Center" Margin="8,0,0,0" Background="{DynamicResource Card}"/>
     <TextBlock x:Name="RateNotice" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/></DockPanel>
   </Border>

   <DockPanel x:Name="LegendRow" Grid.Row="3" Margin="14,0,14,6" MinHeight="28">
    <ToggleButton x:Name="EffectiveOnly" Click="EffectiveChanged" Style="{StaticResource EffectiveSwitch}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="有效伤害 / 溢出总伤"/>
    <WrapPanel x:Name="Legend" MinHeight="24">
    <Border Background="{DynamicResource Physical}" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="物理" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,11,0"/>
    <Border Background="{DynamicResource Arts}" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="法术" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,11,0"/>
    <Border Background="{DynamicResource Elemental}" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="元素" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,11,0"/>
    <Border Background="{DynamicResource True}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="真实" Foreground="{DynamicResource Muted}" FontSize="10"/>
    <TextBlock x:Name="OverkillLegend" Text="▨ 过量伤害" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0" Visibility="Collapsed"/>
    </WrapPanel>
   </DockPanel>

   <Grid x:Name="Plot" Grid.Row="4" MinHeight="120">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TableHeader" Background="{DynamicResource Inset}" MinHeight="28" Margin="0,0,9,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <TextBlock Text="#" Style="{StaticResource Caption}" VerticalAlignment="Center" TextAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="干员" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
     <TextBlock Grid.Column="2" Text="贡献" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
     <TextBlock Grid.Column="3" Text="总量" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
     <TextBlock x:Name="RateHeading" Grid.Column="4" Text="DPS" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
     <TextBlock Grid.Column="5" Text="占比" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
    </Grid>
    <ListBox x:Name="Rows" Grid.Row="1" ItemContainerStyle="{StaticResource RankedRow}" SelectionChanged="RowSelected" MouseEnter="HoldOrder" MouseLeave="ReleaseOrder" MaxHeight="520" MinHeight="80" KeyboardNavigation.DirectionalNavigation="Contained"/>
    <TextBlock x:Name="Empty" Grid.Row="1" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" TextAlignment="Center" FontSize="13" Margin="14"/>
   </Grid>

   <TextBlock x:Name="Coverage" Grid.Row="5" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,8,14,9" TextWrapping="Wrap"/>
   <WrapPanel x:Name="HudControls" Grid.Row="6" Margin="14,0,14,10" Visibility="Collapsed">
    <Button x:Name="LockButton" Content="锁定 HUD" Click="ToggleLock" Padding="10,5"/>
    <TextBlock Text="透明度" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11"/>
    <Slider x:Name="Alpha" Minimum="0.7" Maximum="1" Value="0.9" Width="90" TickFrequency="0.01" ValueChanged="OpacityChanged" VerticalAlignment="Center" AutomationProperties.Name="HUD 透明度"/>
   </WrapPanel>
  </Grid>
 </Border>
</UserControl>
