<UserControl x:Class="ArkDPS.Desktop.StatisticPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ArkDPS.Desktop" MinWidth="400">
 <UserControl.Resources>
  <Style x:Key="ReferenceRankedRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="row" Background="{DynamicResource Console}" BorderBrush="{DynamicResource ConsoleLine}" BorderThickness="0,0,0,1">
     <Grid>
      <ContentPresenter/>
      <Border x:Name="mark" Width="3" HorizontalAlignment="Left" Background="Transparent" IsHitTestVisible="False"/>
      <Border x:Name="focusOutline" BorderBrush="{DynamicResource FocusOnDark}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource ConsoleCard}"/></Trigger>
     <DataTrigger Binding="{Binding Rank}" Value="1"><Setter TargetName="mark" Property="Background" Value="{DynamicResource ReferenceRankLeader}"/></DataTrigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="row" Property="Background" Value="{DynamicResource ReferenceRankSelection}"/>
      <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource ReferenceRankSelectionEdge}"/>
      <Setter TargetName="mark" Property="Background" Value="{DynamicResource ReferenceRankSelectionEdge}"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focusOutline" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ReferencePanelAction" TargetType="Button" BasedOn="{StaticResource Quiet}">
   <Setter Property="Foreground" Value="{DynamicResource ConsoleInk}"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="MinWidth" Value="36"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Padding" Value="7,1"/>
   <Setter Property="Margin" Value="0,0,2,0"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True">
     <Setter Property="Background" Value="{DynamicResource Inset}"/>
     <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ReferenceNumberCell" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
   <Setter Property="Foreground" Value="{DynamicResource ConsoleInk}"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="TextAlignment" Value="Right"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="Margin" Value="0,0,4,0"/>
  </Style>
  <DataTemplate x:Key="ReferenceRow" DataType="{x:Type local:RowItem}">
   <Grid x:Name="ReferenceOperatorRow" Height="36" ToolTip="{Binding Tooltip}" SnapsToDevicePixels="True">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="28"/><ColumnDefinition Width="1.55*" MinWidth="134"/><ColumnDefinition Width="*" MinWidth="30"/>
     <ColumnDefinition Width="74"/><ColumnDefinition Width="66"/><ColumnDefinition Width="56"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource ConsoleInk}" FontFamily="{DynamicResource DataFont}" FontSize="14" VerticalAlignment="Center" TextAlignment="Center"/>
    <Grid Grid.Column="1" Margin="1,0,5,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border x:Name="ReferenceOperatorPortrait" Width="30" Height="30" HorizontalAlignment="Left" Background="{DynamicResource ConsoleCard}" BorderBrush="{DynamicResource ConsoleLine}" BorderThickness="1" ClipToBounds="True">
      <Grid><TextBlock Text="{Binding Initial}" Foreground="{DynamicResource ConsoleInk}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Opacity="{Binding PortraitOpacity}" Stretch="UniformToFill"/></Grid>
     </Border>
     <TextBlock x:Name="ReferenceOperatorName" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource ConsoleInk}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <local:ContributionBar x:Name="ReferenceOperatorContribution" Grid.Column="2" Data="{Binding Entry}" MetricCategory="{Binding MetricCategory}" Height="9" VerticalAlignment="Center" Margin="4,0,4,0"/>
    <TextBlock Grid.Column="3" Text="{Binding Total}" Style="{StaticResource ReferenceNumberCell}"/>
    <TextBlock Grid.Column="4" Text="{Binding Rate}" Style="{StaticResource ReferenceNumberCell}"/>
    <TextBlock Grid.Column="5" Text="{Binding Share}" Style="{StaticResource ReferenceNumberCell}"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="FullRow" DataType="{x:Type local:RowItem}">
   <Grid MinHeight="51" Margin="0,0,6,0" ToolTip="{Binding Tooltip}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource DataFont}" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" CornerRadius="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True">
      <Grid><TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Opacity="{Binding PortraitOpacity}" Stretch="UniformToFill"/></Grid>
     </Border>
     <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock Text="{Binding Presence}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,1,0,0"/>
     </StackPanel>
    </StackPanel>
    <Border Grid.Column="2" Background="Transparent" ToolTip="{Binding BarTooltip}" Margin="4,0,10,0">
     <local:ContributionBar Data="{Binding Entry}" MetricCategory="{Binding MetricCategory}" Height="7" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Grid.Column="3" Text="{Binding Total}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="4" Text="{Binding Rate}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource DataFont}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="5" Text="{Binding Share}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <ControlTemplate x:Key="HudRowsTemplate" TargetType="ListBox">
   <ScrollViewer x:Name="HudRowsViewport" Focusable="False" CanContentScroll="True"
                 VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <ItemsPresenter/>
   </ScrollViewer>
  </ControlTemplate>
  <Style x:Key="HudRankedRow" TargetType="ListBoxItem" BasedOn="{StaticResource RankedRow}">
   <Setter Property="Height" Value="{DynamicResource HudProfileRowHeight}"/>
   <Setter Property="Margin" Value="{DynamicResource HudProfileRowGap}"/>
  </Style>
  <Style x:Key="HudNumber" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{DynamicResource DataFont}"/>
   <Setter Property="FontSize" Value="{DynamicResource HudProfileNumberFont}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="TextAlignment" Value="Right"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <DataTemplate x:Key="HudRow" DataType="{x:Type local:RowItem}">
   <Grid x:Name="HudOperatorRow" Margin="{DynamicResource HudProfileRowPadding}" ClipToBounds="True" ToolTip="{Binding Tooltip}" SnapsToDevicePixels="True">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="{DynamicResource HudProfileRankWidth}"/>
     <ColumnDefinition Width="{DynamicResource HudProfilePortraitWidth}"/>
     <ColumnDefinition Width="{DynamicResource HudProfileNameWidth}"/>
     <ColumnDefinition Width="{DynamicResource HudProfileBarWidth}"/>
     <ColumnDefinition Width="{DynamicResource HudProfileTotalWidth}"/>
     <ColumnDefinition Width="{DynamicResource HudProfileRateWidth}"/>
     <ColumnDefinition Width="{DynamicResource HudProfileShareWidth}"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="HudRankBadge" Margin="2,1,2,1" Background="Transparent">
     <TextBlock Text="{Binding Rank}" Style="{StaticResource HudNumber}" Foreground="{DynamicResource Muted}" TextAlignment="Center"/>
    </Border>
    <Viewbox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
     <Border Width="{DynamicResource HudProfilePortraitSize}" Height="{DynamicResource HudProfilePortraitSize}" CornerRadius="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True">
      <Grid><TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource InterfaceFont}" FontSize="{DynamicResource HudProfileNumberFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Opacity="{Binding PortraitOpacity}" Stretch="UniformToFill"/></Grid>
     </Border>
    </Viewbox>
    <TextBlock x:Name="HudOperatorName" Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource InterfaceFont}" FontSize="{DynamicResource HudProfileNameFont}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="{DynamicResource HudProfileNameGap}"/>
    <Border Grid.Column="3" Background="Transparent" ToolTip="{Binding BarTooltip}" Margin="{DynamicResource HudProfileBarGap}">
     <local:ContributionBar Data="{Binding Entry}" MetricCategory="{Binding MetricCategory}" Height="8" VerticalAlignment="Center"/>
    </Border>
    <TextBlock x:Name="HudOperatorTotal" Grid.Column="4" Text="{Binding Total}" Style="{StaticResource HudNumber}"/>
    <TextBlock Grid.Column="5" Text="{Binding Rate}" Style="{StaticResource HudNumber}" Foreground="{DynamicResource Muted}" Margin="{DynamicResource HudProfileValueGap}"/>
    <TextBlock Grid.Column="6" Text="{Binding Share}" Style="{StaticResource HudNumber}" Margin="{DynamicResource HudProfileValueGap}"/>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Rank}" Value="1"><Setter TargetName="HudRankBadge" Property="Background" Value="{DynamicResource ReferenceRankLeader}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="RankingToolbarAction" TargetType="Button" BasedOn="{StaticResource ReferencePanelAction}">
   <Setter Property="MinWidth" Value="34"/>
   <Setter Property="Padding" Value="5,1"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="{DynamicResource Inset}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style x:Key="EffectiveSwitch" TargetType="ToggleButton">
   <Setter Property="Width" Value="110"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="track" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="2">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="thumb" Grid.Column="1" CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource Accent}"/>
      <TextBlock x:Name="effective" Text="有效伤害" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
      <TextBlock x:Name="overflow" Grid.Column="1" Text="溢出总伤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="thumb" Property="Grid.Column" Value="0"/>
      <Setter TargetName="effective" Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter TargetName="overflow" Property="Foreground" Value="{DynamicResource Muted}"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border x:Name="PanelFrame" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Margin="0,0,12,14">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Border x:Name="TitleRegion">
    <Grid>
     <Border x:Name="LoneTrailHudBackdrop" Visibility="Collapsed" IsHitTestVisible="False">
      <Border.Background>
       <ImageBrush ImageSource="Assets/LoneTrail/orbital-header-banner.png" Stretch="UniformToFill"
                   Viewbox="0.31,0.12,0.69,0.52"/>
      </Border.Background>
      <Border.OpacityMask>
       <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00000000" Offset=".27"/><GradientStop Color="#92000000" Offset=".52"/>
        <GradientStop Color="#D8000000" Offset=".73"/><GradientStop Color="#95000000" Offset=".86"/>
        <GradientStop Color="#28000000" Offset="1"/>
       </LinearGradientBrush>
      </Border.OpacityMask>
     </Border>
     <Image x:Name="PeopleHudArtwork" Source="Assets/People/Components/banner-light.png"
            Height="{Binding ActualHeight, ElementName=TitleRegion}" HorizontalAlignment="Right" Margin="0,0,65,0"
            Opacity=".48" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="BabelHudRule" Data="M 0,0 H 48 L 45,2 H 0 Z" Fill="{DynamicResource Accent}"
           HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False"/>
    <DockPanel x:Name="TitleBar" Margin="14,10,12,8">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Image x:Name="LoneTrailHudChevrons" Source="Assets/LoneTrail/chevrons-silver.png" Width="36" Height="20"
             Opacity=".88" Margin="0,0,3,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Button x:Name="HudClose" Click="CloseHud" Padding="6,1" MinWidth="32" Visibility="Collapsed" ToolTip="关闭 HUD" AutomationProperties.Name="关闭 HUD" Background="Transparent" BorderBrush="{DynamicResource Line}">
       <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stretch="Fill" StrokeThickness="1.5"
             Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" IsHitTestVisible="False"/>
      </Button>
     </StackPanel>
     <DockPanel x:Name="PanelTitle" VerticalAlignment="Center">
      <Border x:Name="TitleAccent" Width="3" Height="18" Background="{DynamicResource Accent}" CornerRadius="1" Margin="0,0,8,0"/>
      <Path x:Name="LoneTrailHudMark" Data="M 5,0 L 12,0 L 7,18 L 0,18 Z" Width="11" Height="18" Stretch="Fill"
            Fill="{DynamicResource Accent}" Margin="0,0,7,0" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Path x:Name="BabelHudMark" Data="M 0,5 L 5,0 L 10,5 L 5,10 Z" Fill="{DynamicResource Accent}"
            Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="Heading" Style="{StaticResource CardTitle}" FontSize="18" VerticalAlignment="Center"/>
       <TextBlock x:Name="PanelKind" Grid.Row="1" Text="LIVE PANEL" FontFamily="{DynamicResource DataFont}" FontSize="10"
                  Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/>
      </Grid>
     </DockPanel>
    </DockPanel>
    </Grid>
   </Border>

   <WrapPanel x:Name="Selectors" Grid.Row="1" Margin="14,0,14,8">
    <StackPanel x:Name="CategoryField" Margin="0,0,8,0"><TextBlock x:Name="CategoryLabel" Text="统计内容" Style="{StaticResource FieldLabel}" ToolTip="选择伤害、治疗或实际吸收的护盾量。"/><ComboBox x:Name="Category" Width="88" SelectionChanged="ConfigurationChanged" AutomationProperties.LabeledBy="{Binding ElementName=CategoryLabel}" AutomationProperties.HelpText="{Binding ToolTip, ElementName=CategoryLabel}" ToolTip="{Binding ToolTip, ElementName=CategoryLabel}">
     <ComboBoxItem Content="伤害" Tag="damage"/><ComboBoxItem Content="治疗" Tag="healing"/><ComboBoxItem Content="有效护盾" Tag="shield"/>
    </ComboBox></StackPanel>
    <StackPanel x:Name="RankingField" Margin="0,0,8,0"><TextBlock x:Name="RankingLabel" Text="排名依据" Style="{StaticResource FieldLabel}" ToolTip="按累计量或每秒速率，从高到低排序。"/><ComboBox x:Name="Ranking" Width="96" SelectionChanged="ConfigurationChanged" AutomationProperties.LabeledBy="{Binding ElementName=RankingLabel}" AutomationProperties.HelpText="{Binding ToolTip, ElementName=RankingLabel}" ToolTip="{Binding ToolTip, ElementName=RankingLabel}" ToolTipService.ShowOnDisabled="True">
     <ComboBoxItem Content="总伤" Tag="total"/><ComboBoxItem Content="DPS" Tag="dps"/>
    </ComboBox></StackPanel>
    <StackPanel x:Name="RateField" Margin="0,0,8,0"><TextBlock x:Name="RateLabel" Text="DPS 口径" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Rate" Width="104" SelectionChanged="ConfigurationChanged" AutomationProperties.LabeledBy="{Binding ElementName=RateLabel}" AutomationProperties.HelpText="{Binding ToolTip, ElementName=RateLabel}" ToolTipService.ShowOnDisabled="True">
     <ComboBoxItem Content="近 5 秒" Tag="recent_5s"/><ComboBoxItem Content="接敌" Tag="engagement"/><ComboBoxItem Content="全周期" Tag="full_cycle"/>
    </ComboBox></StackPanel>
    <ToggleButton x:Name="EffectiveOnly" Click="EffectiveChanged" Style="{StaticResource EffectiveSwitch}" Height="24"
                  VerticalAlignment="Bottom" Margin="0,0,4,3" AutomationProperties.Name="有效伤害 / 溢出总伤"/>
    <StackPanel x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,3">
     <Button x:Name="OpenHudButton" Content="HUD" AutomationProperties.Name="打开 HUD" Click="OpenHud" ToolTip="从本面板打开单屏 HUD" Style="{StaticResource RankingToolbarAction}"/>
     <Button x:Name="DuplicateButton" Content="复制" AutomationProperties.Name="复制统计面板" Click="Duplicate" Style="{StaticResource RankingToolbarAction}"/>
     <Button x:Name="DeleteButton" Content="删除" AutomationProperties.Name="删除统计面板" Click="Delete" Style="{StaticResource RankingToolbarAction}"/>
    </StackPanel>
   </WrapPanel>

   <Border x:Name="RateNoticePanel" Grid.Row="2" Visibility="Collapsed" Margin="14,0,14,8" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="10,7">
    <DockPanel><Button x:Name="RateAction" DockPanel.Dock="Right" Click="RateActionClicked" Padding="9,4" VerticalAlignment="Center" Margin="8,0,0,0" Background="{DynamicResource Card}"/>
     <TextBlock x:Name="RateNotice" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/></DockPanel>
   </Border>

   <DockPanel x:Name="LegendRow" Grid.Row="3" Margin="14,0,14,6" MinHeight="28">
    <WrapPanel x:Name="Legend" MinHeight="24">
    <Border Background="{DynamicResource Physical}" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="物理" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,11,0"/>
    <Border Background="{DynamicResource Arts}" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="法术" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,11,0"/>
    <Border Background="{DynamicResource Elemental}" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="元素" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,11,0"/>
    <Border Background="{DynamicResource True}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="1" Width="8" Height="8" Margin="0,0,4,0"/><TextBlock Text="真实" Foreground="{DynamicResource Muted}" FontSize="10"/>
    <TextBlock x:Name="OverkillLegend" Text="▨ 过量伤害" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0" Visibility="Collapsed"/>
    </WrapPanel>
   </DockPanel>

   <Grid x:Name="Plot" Grid.Row="4" MinHeight="120">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="TableHeader" Background="{DynamicResource Inset}" MinHeight="28" Margin="0,0,9,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <TextBlock Text="#" Style="{StaticResource Caption}" VerticalAlignment="Center" TextAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="干员" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
     <TextBlock Grid.Column="2" Text="贡献" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
     <TextBlock Grid.Column="3" Text="总量" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
     <TextBlock x:Name="RateHeading" Grid.Column="4" Text="DPS" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
     <TextBlock x:Name="ShareHeading" Grid.Column="5" Text="占比" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
    </Grid>
    <Grid x:Name="ReferenceTableHeader" Background="{DynamicResource ConsoleCard}" MinHeight="29" Visibility="Collapsed">
     <Grid.ColumnDefinitions>
     <ColumnDefinition Width="28"/><ColumnDefinition Width="1.55*" MinWidth="134"/><ColumnDefinition Width="*" MinWidth="30"/>
     <ColumnDefinition Width="74"/><ColumnDefinition Width="66"/><ColumnDefinition Width="56"/>
    </Grid.ColumnDefinitions>
     <TextBlock Text="#" Foreground="{DynamicResource ConsoleInk}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="干员" Foreground="{DynamicResource ConsoleInk}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,0,0"/>
     <TextBlock x:Name="ReferenceContributionHeading" Grid.Column="2" Text="贡献" Foreground="{DynamicResource ConsoleInk}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
     <TextBlock x:Name="ReferenceTotalHeading" Grid.Column="3" Text="总伤" Style="{StaticResource ReferenceNumberCell}" FontSize="13" FontWeight="SemiBold"/>
     <TextBlock x:Name="ReferenceRateHeading" Grid.Column="4" Text="DPS" Style="{StaticResource ReferenceNumberCell}" FontSize="13" FontWeight="SemiBold"/>
     <TextBlock x:Name="ReferenceShareHeading" Grid.Column="5" Text="占比" Style="{StaticResource ReferenceNumberCell}" FontSize="13" FontWeight="SemiBold"/>
    </Grid>
    <ListBox x:Name="Rows" Grid.Row="1" ItemContainerStyle="{StaticResource RankedRow}" ScrollViewer.ScrollChanged="ReferenceScrollChanged" SelectionChanged="RowSelected" MouseEnter="HoldOrder" MouseLeave="ReleaseOrder" MaxHeight="520" MinHeight="80" KeyboardNavigation.DirectionalNavigation="Contained"/>
    <TextBlock x:Name="Empty" Grid.Row="1" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" TextAlignment="Center" FontSize="13" Margin="14"/>
    <Grid x:Name="ReferenceFooter" Grid.Row="2" Background="{DynamicResource ConsoleCard}" MinHeight="31" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="28"/><ColumnDefinition Width="1.55*" MinWidth="134"/><ColumnDefinition Width="*" MinWidth="30"/>
     <ColumnDefinition Width="74"/><ColumnDefinition Width="66"/><ColumnDefinition Width="56"/>
    </Grid.ColumnDefinitions>
     <Border Grid.ColumnSpan="6" BorderBrush="{DynamicResource ConsoleLine}" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
     <TextBlock Text="∑" Foreground="{DynamicResource ConsoleMuted}" FontSize="14" VerticalAlignment="Center" TextAlignment="Center"/>
     <TextBlock x:Name="ReferenceFooterLabel" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{DynamicResource ConsoleInk}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,0,0"/>
     <TextBlock x:Name="ReferenceFooterTotal" Grid.Column="3" Style="{StaticResource ReferenceNumberCell}" FontWeight="SemiBold"/>
     <TextBlock x:Name="ReferenceFooterRate" Grid.Column="4" Style="{StaticResource ReferenceNumberCell}" FontWeight="SemiBold"/>
    </Grid>
   </Grid>

   <TextBlock x:Name="Coverage" Grid.Row="5" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,8,14,9" TextWrapping="Wrap"/>
   <WrapPanel x:Name="HudControls" Grid.Row="6" Margin="14,0,14,10" Visibility="Collapsed">
    <Button x:Name="LockButton" Content="锁定 HUD" Click="ToggleLock" Padding="10,5"/>
    <TextBlock x:Name="HudOpacityLabel" Text="透明度" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11"/>
    <Slider x:Name="Alpha" Minimum="0.7" Maximum="1" Value="0.9" Width="90" TickFrequency="0.01" ValueChanged="OpacityChanged" VerticalAlignment="Center" AutomationProperties.Name="HUD 透明度"/>
   </WrapPanel>
  </Grid>
 </Border>
</UserControl>
