<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/arkdps.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArkDpsInternalEventCandidate)' == 'true'">
    <ApplicationManifest>app.internal-events.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);ARKDPS_INTERNAL_EVENT_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArkDpsCooperativeEventCandidate)' == 'true'">
    <DefineConstants>$(DefineConstants);ARKDPS_COOPERATIVE_EVENT_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArkDpsNativeHookCandidate)' == 'true'">
    <DefineConstants>$(DefineConstants);ARKDPS_NATIVE_HOOK_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="VerificationFixtures/inspector-readings.json" LogicalName="ArkDPS.InspectorReadings" />
    <Resource Include="Assets/LoneTrail/*.png" />
    <Resource Include="Assets/People/**/*.png;Assets/People/**/*.jpg" />
    <Resource Include="Assets/Babel/**/*.png;Assets/Babel/**/*.jpg" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <None Update="Assets/Fonts/*-OFL.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
