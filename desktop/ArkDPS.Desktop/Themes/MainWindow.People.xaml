<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <LinearGradientBrush x:Key="FrameSurface" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#EFE5D6" Offset="0"/><GradientStop Color="#E8DCCB" Offset=".27"/>
  <GradientStop Color="#D4C3AF" Offset="1"/>
 </LinearGradientBrush>
 <SolidColorBrush x:Key="FrameEdge" Color="#8B7767"/>
 <SolidColorBrush x:Key="FrameInnerEdge" Color="#A08B77"/>
 <SolidColorBrush x:Key="FrameInk" Color="#262322"/>
 <SolidColorBrush x:Key="FrameMuted" Color="#55483E"/>
 <SolidColorBrush x:Key="FrameAccent" Color="#8D312A"/>
 <BitmapImage x:Key="FrameSlashes" UriSource="/Assets/People/slash-red.png"/>
 <SolidColorBrush x:Key="MetricSurface" Color="#302B28"/>
 <SolidColorBrush x:Key="MetricEdge" Color="#716357"/>
 <SolidColorBrush x:Key="MetricInk" Color="#FAEEE1"/>
 <SolidColorBrush x:Key="MetricMuted" Color="#E1CFC0"/>
 <SolidColorBrush x:Key="MetricHighlight" Color="#C25E50"/>
 <SolidColorBrush x:Key="MetricSignal" Color="#F39481"/>
 <SolidColorBrush x:Key="ChromeBrandSurface" Color="#EB302724"/>
 <SolidColorBrush x:Key="ChromeDescriptionSurface" Color="#F0EDE3D3"/>
 <SolidColorBrush x:Key="ChromeControlsSurface" Color="#F0EDE3D3"/>
 <SolidColorBrush x:Key="ChromeButtonSurface" Color="#E8DAC9"/>
 <SolidColorBrush x:Key="ChromeButtonHover" Color="#D4C3AF"/>
 <SolidColorBrush x:Key="ChromeButtonEdge" Color="#9D8270"/>
 <SolidColorBrush x:Key="ChromeInk" Color="#282321"/>
 <SolidColorBrush x:Key="ChromeMuted" Color="#5F4D42"/>
 <ImageBrush x:Key="ShellBackdrop" ImageSource="/Assets/People/people-square-landscape.jpg" Stretch="UniformToFill" Opacity=".42"/>
 <SolidColorBrush x:Key="SubpageHeadingSurface" Color="Transparent"/>
 <SolidColorBrush x:Key="SubpageHeadingInk" Color="#161211"/>
 <Thickness x:Key="SubpageHeadingPadding">10,5,16,5</Thickness>
 <SolidColorBrush x:Key="ShellSidebarEdge" Color="#6E5547"/>
 <ImageBrush x:Key="ShellSidebarArtwork" ImageSource="/Assets/People/people-street-portrait.jpg" Stretch="UniformToFill" AlignmentX="Left"/>
 <LinearGradientBrush x:Key="ShellSidebarShade" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#AA302723" Offset="0"/><GradientStop Color="#38302723" Offset=".48"/>
  <GradientStop Color="#12302723" Offset=".74"/><GradientStop Color="#6C302723" Offset="1"/>
 </LinearGradientBrush>
 <SolidColorBrush x:Key="ShellNavActive" Color="#752C28"/>
 <SolidColorBrush x:Key="ShellNavSelectedEdge" Color="#C77F6D"/>
 <Pen x:Key="PeopleNavIconPen" Brush="#F1DEC8" Thickness="1.8"
      StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
 <GeometryDrawing x:Key="PeopleNavIconBounds" Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
 <DrawingImage x:Key="ShellLiveNavIcon">
  <DrawingImage.Drawing>
   <DrawingGroup>
    <StaticResource ResourceKey="PeopleNavIconBounds"/>
    <GeometryDrawing Pen="{StaticResource PeopleNavIconPen}" Geometry="M3,4 V20 H21 M6,14 H9 L12,7 L15,16 L18,11 H21"/>
   </DrawingGroup>
  </DrawingImage.Drawing>
 </DrawingImage>
 <DrawingImage x:Key="ShellEnemyNavIcon">
  <DrawingImage.Drawing>
   <DrawingGroup>
    <StaticResource ResourceKey="PeopleNavIconBounds"/>
    <GeometryDrawing Pen="{StaticResource PeopleNavIconPen}">
     <GeometryDrawing.Geometry>
      <GeometryGroup>
       <EllipseGeometry Center="12,12" RadiusX="7.5" RadiusY="7.5"/>
       <EllipseGeometry Center="12,12" RadiusX="2" RadiusY="2"/>
       <PathGeometry Figures="M12,2 V6 M12,18 V22 M2,12 H6 M18,12 H22"/>
      </GeometryGroup>
     </GeometryDrawing.Geometry>
    </GeometryDrawing>
   </DrawingGroup>
  </DrawingImage.Drawing>
 </DrawingImage>
 <DrawingImage x:Key="ShellHistoryNavIcon">
  <DrawingImage.Drawing>
   <DrawingGroup>
    <StaticResource ResourceKey="PeopleNavIconBounds"/>
    <GeometryDrawing Pen="{StaticResource PeopleNavIconPen}">
     <GeometryDrawing.Geometry>
      <GeometryGroup>
       <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
       <PathGeometry Figures="M12,7 V12 L16,14"/>
      </GeometryGroup>
     </GeometryDrawing.Geometry>
    </GeometryDrawing>
   </DrawingGroup>
  </DrawingImage.Drawing>
 </DrawingImage>
 <DrawingImage x:Key="ShellSettingsNavIcon">
  <DrawingImage.Drawing>
   <DrawingGroup>
    <StaticResource ResourceKey="PeopleNavIconBounds"/>
    <GeometryDrawing Pen="{StaticResource PeopleNavIconPen}"
                     Geometry="M3,6 H8 M12,6 H21 M8,3 V9 H12 V3 Z M3,12 H13 M17,12 H21 M13,9 V15 H17 V9 Z M3,18 H7 M11,18 H21 M7,15 V21 H11 V15 Z"/>
   </DrawingGroup>
  </DrawingImage.Drawing>
 </DrawingImage>
 <BitmapImage x:Key="PeopleMasthead" UriSource="/Assets/People/masthead-paper.png"/>
 <BitmapImage x:Key="PeopleEmblem" UriSource="/Assets/People/emblem-paper.png"/>
 <BitmapImage x:Key="PeoplePennantArtwork" UriSource="/Assets/People/people-pennant-red.png"/>
</ResourceDictionary>
