<Window x:Class="ArkDPS.Desktop.HudLayoutEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="HUD 布局"
 Width="1120" Height="780" MinWidth="730" MinHeight="470"
 ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterOwner"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Border Background="{DynamicResource Bg}">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <TextBlock Text="HUD 布局" Style="{StaticResource PageTitle}" FontSize="25"/>
   <TextBlock x:Name="SourceTitle" Foreground="{DynamicResource Muted}" FontSize="14" Margin="14,3,0,0"
              VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="54*"/><RowDefinition Height="46*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,0,10">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel LastChildFill="False">
      <TextBlock x:Name="PreviewLabel" Text="布局预览" Style="{StaticResource CardTitle}" FontSize="16"/>
      <TextBlock x:Name="PreviewSize" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
     </DockPanel>
     <StackPanel x:Name="ScaleFieldHost" Grid.Row="1" MaxWidth="380" HorizontalAlignment="Stretch"
                 Margin="0,9,0,0"/>
     <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
              HorizontalAlignment="Center" Margin="0,10,0,0" IsHitTestVisible="False">
      <Border x:Name="PreviewSurface"/>
     </Viewbox>
    </Grid>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <UniformGrid x:Name="Fields" Rows="1" Columns="3"/>
   </ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,12,0,0">
   <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="恢复默认" Click="ResetClick"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="78"/>
    <Button x:Name="SaveButton" Content="保存布局" Click="SaveClick" Style="{StaticResource Primary}" MinWidth="96" Margin="0"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Foreground="{DynamicResource Danger}" Margin="8,0,8,0" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
 </Border>
</Window>
