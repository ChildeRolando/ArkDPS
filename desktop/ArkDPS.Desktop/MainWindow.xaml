      <StackPanel DockPanel.Dock="Top" Margin="0,0,4,10">
       <WrapPanel><Button Content="收起 / 展开列表" Click="ToggleHistoryList" Padding="10,6"/><Button x:Name="ExportJson" Content="导出 JSON" Click="SaveJson" IsEnabled="False" Padding="10,6"/><Button x:Name="ExportPng" Content="完整排行 PNG" Click="SavePng" IsEnabled="False" Style="{StaticResource Primary}" Padding="12,6"/></WrapPanel>
       <TextBlock x:Name="HistorySummary" Text="暂无可读战绩；完成对局归档后自动出现。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock x:Name="HistoryNotice" Foreground="{DynamicResource Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><local:StatisticPanel x:Name="HistoryPanel" Margin="0,0,0,12"/><local:Inspector x:Name="HistoryInspector"/></StackPanel></ScrollViewer>
     </DockPanel>
    </Grid>

    <ScrollViewer x:Name="EnemyPageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,0">
    <Grid x:Name="EnemyPage" Margin="0,0,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <UniformGrid x:Name="EnemyMetrics" Columns="4" Margin="0,0,0,8">
      <Border Style="{StaticResource MetricCard}" Grid.Column="0" Margin="0,0,8,0"><StackPanel><TextBlock Text="已入场敌人" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyEntered" Text="—" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="含已离场实例" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="1" Margin="0,0,8,0"><StackPanel><TextBlock Text="已入场总血量" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyTotalHp" Text="—" Foreground="{DynamicResource Accent}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="随入场和重生累计" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="2" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="EnemyOurDamageLabel" Text="我方有效伤害" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyOurDamage" Text="—" Foreground="{DynamicResource Good}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="干员与归属召唤物" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="3" Margin="0"><StackPanel><TextBlock Text="敌方剩余" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyRemaining" Text="—" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock x:Name="EnemyRemainingScope" Text="仅场上存活实例" Style="{StaticResource Caption}"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition x:Name="EnemyChartColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="EnemyRosterRow" Height="*"/><RowDefinition x:Name="EnemyChartRow" Height="0"/></Grid.RowDefinitions>
      <Border x:Name="EnemyRosterHost" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,12,0">
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="已入场敌人" DockPanel.Dock="Left" Style="{StaticResource CardTitle}" FontSize="18"/><TextBlock x:Name="EnemyStatusText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom"/></DockPanel>
        <TextBlock x:Name="EnemyStatusHint" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Grid>
         <ListBox x:Name="EnemyList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已入场敌人">
          <ListBox.ItemTemplate><DataTemplate><Border Padding="8,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding Tooltip}"><StackPanel>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Badge}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Stretch="UniformToFill"/></Grid></Border>
            <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Eid}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource DataFont}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="10" TextAlignment="Right"/><TextBlock Text="{Binding HpText}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="12" TextAlignment="Right" Margin="0,2,0,0"/></StackPanel>
           </Grid>
           <ProgressBar Value="{Binding HpPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,7,0,5" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0">
            <ProgressBar.Style>
             <Style TargetType="ProgressBar">
              <Style.Triggers>
               <DataTrigger Binding="{Binding HpPercentKnown}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </ProgressBar.Style>
           </ProgressBar>
           <TextBlock Text="{Binding PhaseHpText}" Foreground="{DynamicResource Ink}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Style.Triggers>
               <DataTrigger Binding="{Binding PhaseHpText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding AttrsText}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <TextBlock x:Name="EnemyEmpty" Text="场上暂无已入场敌人。" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Visibility="Collapsed"/>
        </Grid>
       </DockPanel>
      </Border>
      <Border x:Name="EnemyChartHost" Style="{StaticResource SurfaceCard}" Grid.Column="1" Padding="12">
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="血量 / 有效伤害" DockPanel.Dock="Left" Style="{StaticResource CardTitle}" FontSize="18"/><TextBlock Text="按游戏时间" Foreground="{DynamicResource Muted}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Bottom"/></DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Accent}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendTotal" Text="已入场总血量" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,12,0"/>
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Good}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendDamage" Text="我方有效伤害" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,12,0"/>
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Muted}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendRemaining" Text="敌方剩余" Foreground="{DynamicResource Muted}" FontSize="10"/>
        </WrapPanel>
        <local:EnemyChart x:Name="EnemyChart"/>
       </DockPanel>
      </Border>
     </Grid>
    </Grid>
    </ScrollViewer>

    <local:MultiplayerView x:Name="MultiplayerPage" Visibility="Collapsed"/>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,0">
     <Grid MaxWidth="1080">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsRightColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="SettingsConnectionColumn" Grid.Row="0" Margin="0,0,12,0">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="ReleaseSettingsCard" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12" Visibility="{Binding Visibility, ElementName=ReleaseSettings}">
       <StackPanel x:Name="ReleaseSettings" Visibility="Collapsed">
        <TextBlock Text="版本与更新" Style="{StaticResource CardTitle}" FontSize="20" Margin="0,0,0,14"/>
        <WrapPanel>
         <TextBlock x:Name="InstalledVersion" Style="{StaticResource FieldLabel}" Margin="0,0,16,8" VerticalAlignment="Center"/>
         <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateClick" Margin="0,0,8,8"/>
         <Button x:Name="UpdateAction" Click="UpdateActionClick" Visibility="Collapsed" Margin="0,0,8,8"/>
         <Button x:Name="UpdateReleasePage" Content="查看发布页" Click="OpenReleaseDownload" Visibility="Collapsed" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock x:Name="UpdateStatus" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <ProgressBar x:Name="UpdateProgressBar" Height="4" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="更新下载进度"/>
       </StackPanel>
      </Border>
      <Border x:Name="ConnectionForm" Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="20" VerticalAlignment="Stretch" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="连接设置" Style="{StaticResource CardTitle}" FontSize="20"/>
        <TextBlock Text="采集来源" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ComboBox x:Name="ConnectionPlatform" SelectedIndex="0" AutomationProperties.Name="采集来源" SelectionChanged="ConnectionPlatformChanged">
         <ComboBoxItem Content="MuMu 模拟器" Tag="mumu"/>
         <ComboBoxItem Content="明日方舟 PC 版" Tag="native_pc"/>
        </ComboBox>
        <StackPanel x:Name="MumuConnectionFields" Margin="0,12,0,0">
         <CheckBox x:Name="AutoDetect"><TextBlock Text="自动检测 MuMu 实例（多实例时手动选择）" TextWrapping="Wrap"/></CheckBox>
         <TextBlock Text="ADB 路径 · 留空自动查找" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
         <TextBox x:Name="AdbPath" AutomationProperties.Name="ADB 路径" TextChanged="ConnectionInputEdited"
                  ToolTip="自动查找到的路径会填在这里。手动编辑后，应用设置将使用指定路径。"/>
         <TextBlock Text="端口地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
         <TextBox x:Name="Serial" TextChanged="ConnectionInputEdited" AutomationProperties.Name="端口地址"
                  ToolTip="唯一可用实例会自动填入。多实例时选择检测结果；手动输入的地址不会被自动替换。"/>
         <Button x:Name="DetectButton" Content="检测实例" Click="Detect" HorizontalAlignment="Left" Margin="0,12,0,8"/>
         <ListBox x:Name="Instances" MinHeight="46" MaxHeight="140" SelectionChanged="ChooseInstance"/>
        </StackPanel>
        <StackPanel x:Name="NativeConnectionFields" Visibility="Collapsed" Margin="0,12,0,0">
         <TextBlock Text="PC 游戏目录" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
         <DockPanel>
          <Button Content="选择目录" DockPanel.Dock="Right" Click="ChooseNativeGameRoot" Margin="8,0,0,0"/>
          <TextBox x:Name="NativeGameRoot" AutomationProperties.Name="PC 游戏目录" ToolTip="选择包含 Arknights.exe 的目录"/>
         </DockPanel>
        </StackPanel>
        <TextBlock x:Name="DetectionNote" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      </Grid>
      <Border x:Name="ConnectionEventForm" Grid.Row="0" Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="20" VerticalAlignment="Stretch" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="事件观察者与连接诊断" Style="{StaticResource CardTitle}" FontSize="20" TextWrapping="Wrap"/>
        <CheckBox x:Name="EventsEnabled" Content="启用战斗事件观察者" AutomationProperties.Name="启用战斗事件观察者" Margin="0,14,0,7"/>
        <TextBlock Text="记录逐次伤害、治疗、实际吸盾与技能起止。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <StackPanel x:Name="MumuEventNotes">
         <TextBlock Text="启动步骤" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <TextBlock Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="22" TextWrapping="Wrap">
          <Run Text="1. 启动 MuMu 和游戏，开启模拟器的 ADB 与 Root。"/><LineBreak/>
          <Run Text="2. 点击「检测实例」。多实例时选择正在游玩的实例。"/><LineBreak/>
          <Run Text="3. 点击「应用设置并重连」，等待观察者就绪，再开始战斗。"/>
         </TextBlock>
        </StackPanel>
        <StackPanel x:Name="NativeEventNotes" Visibility="Collapsed">
         <TextBlock Text="PC 事件后端" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
         <ComboBox x:Name="NativeEventBackend" SelectedIndex="0" AutomationProperties.Name="PC 事件后端" SelectionChanged="NativeEventBackendChanged" Margin="0,0,0,12"
                   ToolTip="{StaticResource NativeEventBackendAdvice}" AutomationProperties.HelpText="{StaticResource NativeEventBackendAdvice}">
          <ComboBoxItem Content="Frida" Tag="frida" ToolTip="{StaticResource NativeEventBackendAdvice}" AutomationProperties.HelpText="{StaticResource NativeEventBackendAdvice}"/>
          <ComboBoxItem Content="ArkPie" Tag="native" ToolTip="{StaticResource NativeEventBackendAdvice}" AutomationProperties.HelpText="{StaticResource NativeEventBackendAdvice}"/>
         </ComboBox>
         <TextBlock x:Name="NativeEventBackendHint" Text="{StaticResource NativeEventBackendAdvice}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
         <TextBlock Text="事件队列内存上限" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
         <DockPanel Margin="0,0,0,6">
          <Button Content="保存上限" DockPanel.Dock="Right" Click="SaveEventQueueMemory" Margin="8,0,0,0" AutomationProperties.Name="保存事件队列内存上限"/>
          <TextBox x:Name="EventQueueMemory" Text="1024" AutomationProperties.Name="事件队列内存上限（MiB）" ToolTip="512–2048 MiB；保存后下次游戏启动生效"/>
         </DockPanel>
         <TextBlock Text="MiB · 512–2048。全进程采集队列预算，包含元数据与事件内容，不代表程序总内存。保存后下次游戏启动生效。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <TextBlock x:Name="EventQueueMemoryStatus" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
         <StackPanel x:Name="NativeHookNotes" Visibility="Collapsed">
          <TextBlock Text="启动步骤" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,8"/>
          <TextBlock Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="22" TextWrapping="Wrap">
           <Run Text="1. 选择游戏目录，启用战斗事件观察者。"/><LineBreak/>
           <Run Text="2. 点击「应用设置并重连」，等待「ArkPie · 监听已就绪」。"/><LineBreak/>
           <Run Text="3. 正常启动或重启游戏，进入大厅等待观察者就绪，再开始战斗。"/>
          </TextBlock>
         <Expander Header="状态含义" Foreground="{DynamicResource Ink}" Margin="0,8,0,0" AutomationProperties.Name="ArkPie 状态含义">
          <Grid Margin="0,10,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
           <TextBlock Grid.Row="0" Text="准备监听" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="0" Grid.Column="1" Text="等待程序完成监听准备。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="1" Text="监听已就绪" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="1" Grid.Column="1" Text="保持 ArkDPS 开启，正常启动或重启游戏。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="2" Text="正在连接游戏" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="2" Grid.Column="1" Text="等待 ArkPie 组件建立连接。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="3" Text="等待游戏初始化" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="3" Grid.Column="1" Text="进入游戏大厅后稍候。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="4" Text="观察者就绪" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="4" Grid.Column="1" Text="等待本轮战斗样本，进入战斗后开始统计。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="5" Text="需要重启" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="5" Grid.Column="1" Text="保持 ArkDPS 开启，正常重启游戏。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="6" Text="正在释放旧会话" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="6" Grid.Column="1" Text="等待会话释放。持续提示时，退出旧版 ArkDPS 并重启游戏。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
          </Grid>
         </Expander>
         </StackPanel>
         <StackPanel x:Name="FridaEventNotes" Visibility="Visible">

          <TextBlock Text="启动步骤" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,8"/>
          <TextBlock Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="22" TextWrapping="Wrap">
           <Run Text="1. 选择游戏目录，启用战斗事件观察者。"/><LineBreak/>
           <Run Text="2. 点击「应用设置并重连」，等待「Frida · 监听已就绪」。"/><LineBreak/>
           <Run Text="3. 正常启动或重启游戏，进入大厅等待观察者就绪，再开始战斗。"/>
          </TextBlock>
         <Expander Header="状态含义" Foreground="{DynamicResource Ink}" Margin="0,8,0,0" AutomationProperties.Name="Frida 状态含义">
          <Grid Margin="0,10,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
           <TextBlock Grid.Row="0" Text="准备监听" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="0" Grid.Column="1" Text="等待程序完成监听准备。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="1" Text="监听已就绪" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="1" Grid.Column="1" Text="保持 ArkDPS 开启，正常启动或重启游戏。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="2" Text="正在连接游戏" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="2" Grid.Column="1" Text="等待 Frida 组件建立连接。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="3" Text="等待游戏初始化" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="3" Grid.Column="1" Text="进入游戏大厅后稍候。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="4" Text="观察者就绪" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="4" Grid.Column="1" Text="等待本轮战斗样本，进入战斗后开始统计。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="5" Text="需要重启" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="5" Grid.Column="1" Text="保持 ArkDPS 开启，正常重启游戏。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
           <TextBlock Grid.Row="6" Text="端口被占用" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="12" Margin="0,0,14,8"/>
           <TextBlock Grid.Row="6" Grid.Column="1" Text="退出旧版 ArkDPS（含托盘），等待状态刷新。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8"/>
          </Grid>
         </Expander>
         </StackPanel>
         <StackPanel x:Name="NativeEventFeedFields" Visibility="Collapsed" Margin="0,12,0,0">
          <TextBlock Text="合作事件文件（可选）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
          <DockPanel>
           <Button Content="选择文件" DockPanel.Dock="Right" Click="ChooseNativeEventFeed" Margin="8,0,0,0"/>
           <TextBox x:Name="NativeEventFeed" AutomationProperties.Name="事件数据文件" ToolTip="留空使用 ArkPie 实时采集；填写完整路径则读取合作来源的 JSONL"/>
          </DockPanel>
         </StackPanel>
        </StackPanel>

       </StackPanel>
      </Border>
      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsActionColumn" Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel>
          <TextBlock Text="当前状态" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="ConnectionStatusSummary" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="23" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="ConnectionObserverStatus" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0"/>
          <TextBlock x:Name="ConnectionAppliedBackend" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/>
          <Expander Header="详细诊断" Foreground="{DynamicResource Muted}" Margin="0,10,0,0">
           <TextBlock x:Name="ConnectionDiagnostics" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" />
          </Expander>
         </StackPanel>
        <StackPanel x:Name="SettingsApplyActions" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24,0,0,0" MaxWidth="260">
         <Button Content="应用设置并重连" Click="ApplySettings" Style="{StaticResource Primary}" HorizontalAlignment="Right" MinHeight="36"/>
         <TextBlock Text="连接与观察者选项在应用后生效。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>
       </Grid>
      </Border>
      <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="统计与显示" Style="{StaticResource CardTitle}" FontSize="20"/>
        <TextBlock Text="更改后自动保存。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,14"/>
        <WrapPanel>
         <TextBlock Text="数值缩写单位" Style="{StaticResource FieldLabel}" Margin="0,0,16,6" VerticalAlignment="Center"/>
         <ComboBox x:Name="NumberUnits" AutomationProperties.Name="数值缩写单位" SelectionChanged="NumberUnitsChanged" MinWidth="150" Margin="0,0,0,6">
          <ComboBoxItem Content="K / M" Tag="western"/><ComboBoxItem Content="万 / 亿" Tag="chinese"/>
         </ComboBox>
        </WrapPanel>
        <CheckBox x:Name="MultiplayerEnabledSetting" Content="统计卫戍队友DPS" IsChecked="False" IsEnabled="False" Click="MultiplayerEnabledChanged" Margin="0,10,0,0" AutomationProperties.Name="统计卫戍队友DPS" ToolTipService.ShowOnDisabled="True" ToolTip="卫戍队友DPS仅支持 PC"/>
        <TextBlock Text="适用于 PC；开关从下一小局生效。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/>
        <TextBlock x:Name="MultiplayerSettingStatus" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,16,0,0">
         <TextBlock Text="HUD 布局" Style="{StaticResource FieldLabel}" Margin="0,0,16,6" VerticalAlignment="Center"/>
         <ComboBox x:Name="HudLayoutTarget" AutomationProperties.Name="HUD 源面板" DisplayMemberPath="Label" MinWidth="150" MaxWidth="230" Margin="0,0,8,6"/>
         <Button x:Name="EditHudLayoutButton" Content="调整布局" Click="EditHudLayoutClick" Margin="0,0,0,6" IsEnabled="False"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="诊断工具" Style="{StaticResource CardTitle}" FontSize="20"/>
        <ToggleButton x:Name="DebugModeSetting" Content="开启调试模式" Click="ChangeDebugMode" AutomationProperties.Name="调试模式" AutomationProperties.HelpText="开启详细采集日志" HorizontalAlignment="Left" Margin="0,14,0,6"/>
        <TextBlock Text="记录详细采集日志，会增加磁盘写入。排查完成后可随时关闭。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        <ToggleButton x:Name="PerformanceTimingSetting" Content="性能计时（低开销）" Click="ChangePerformanceTiming" AutomationProperties.Name="性能计时" HorizontalAlignment="Left" Margin="0,12,0,6"/>
        <TextBlock Text="按秒记录采集与界面耗时；原生回调抽样计时，无需开启详细调试日志。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock Text="线程调用栈采样" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6"/>
        <TextBlock Text="在侧边面板开始采样。记录 45 秒后自动保存，也可提前结束。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        <Button Content="打开采样目录" Click="OpenStackCaptureDirectory" HorizontalAlignment="Left" Margin="0,10,0,4"/>
        <TextBlock x:Name="StackCaptureStatus" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>

     </Grid>
    </ScrollViewer>
   </Grid>

   <TextBlock x:Name="Footer" Grid.Row="2" Visibility="Collapsed"/>
  </Grid>
 </Grid>
 <Border x:Name="SideRoot" Visibility="Collapsed" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource FrameEdge}" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Border x:Name="SideToolbar" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Padding="10,5">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="Assets/LoneTrail/arkdps-icon.png" Width="25" Height="20" Margin="0,0,6,0"/>
      <TextBlock Text="ArkDPS" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DisplayFont}"
                 FontWeight="Bold" FontSize="19" VerticalAlignment="Center"/>
     </StackPanel>
     <Button x:Name="SideStackCaptureButton" Grid.Column="1" Content="栈采样" Click="ToggleStackCapture"
             MinHeight="30" Padding="7,3" Margin="0,0,4,0" ToolTip="开始线程调用栈采样"
             AutomationProperties.Name="开始线程调用栈采样"/>
     <Button x:Name="LeaveSideMode" Grid.Column="2" Content="恢复主面板" Click="ToggleSideMode"
             MinHeight="30" Padding="7,3" Margin="0,0,4,0"/>
     <Button Grid.Column="3" Click="MinimizeWindow" MinHeight="30" Width="30" Padding="4" Margin="0"
             ToolTip="最小化" AutomationProperties.Name="最小化">
      <Path Data="M 0 5 H 10" Stroke="{DynamicResource Ink}" StrokeThickness="1.2"/>
     </Button>
    </Grid>
   </Border>
   <TabControl x:Name="SideTabs" Grid.Row="1" Padding="6" AutomationProperties.Name="侧边战况">
    <TabControl.Template><ControlTemplate TargetType="TabControl">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1">
       <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
      </Border>
      <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                        Margin="{TemplateBinding Padding}"/>
     </Grid>
    </ControlTemplate></TabControl.Template>
    <TabItem x:Name="SideFriendlyTab" Header="我方" Style="{StaticResource SideTab}"><local:SideFriendlyView x:Name="SideFriendly"/></TabItem>
    <TabItem Header="敌方" Style="{StaticResource SideTab}"><ContentControl x:Name="SideEnemyHost"
          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem>
   </TabControl>
   <Border x:Name="SideStatusBar" Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="10,5">
    <StackPanel>
     <TextBlock x:Name="SideAttachmentStatus" Visibility="Collapsed" Foreground="{DynamicResource Ink}" FontSize="12"/>
     <TextBlock x:Name="SideStackCaptureStatus" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11"
                Margin="0,0,0,3" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
     <DockPanel x:Name="SideStatusLine" ToolTip="{Binding ToolTip, ElementName=StatusBadge}">
      <Button x:Name="SideEventCaptureButton" DockPanel.Dock="Right" Content="暂停采集" Click="ToggleEventCapture"
              MinWidth="82" MinHeight="30" Padding="7,3" Margin="6,0,0,0" IsEnabled="False"
              ToolTip="等待采集端报告事件采集状态" ToolTipService.ShowOnDisabled="True"
              AutomationProperties.Name="暂停采集" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="SideGameFpsStatus" DockPanel.Dock="Right" Text="FPS —" Width="68" Margin="6,0,0,0"
                 Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource DataFont}" FontSize="11"
                 TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 ToolTip="等待游戏帧率采样"/>
      <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
               Fill="{Binding Fill, ElementName=StatusLight}"/>
      <TextBlock x:Name="SideDataStatus" Text="{Binding Text, ElementName=Status}" Foreground="{DynamicResource Muted}" FontSize="11"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
 </Grid>
 </Border>
</Window>
