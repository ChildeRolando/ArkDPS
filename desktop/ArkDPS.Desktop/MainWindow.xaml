<Window x:Class="ArkDPS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArkDPS.Desktop"
 Style="{StaticResource {x:Type Window}}" Title="ArkDPS · 局内统计" WindowStyle="None" Width="1672" Height="941" MinWidth="560" MinHeight="540" Closing="OnClosing" SizeChanged="OnResize"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="ResearchFrame" TargetType="HeaderedContentControl">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="HeaderedContentControl">
    <Grid>
     <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource FrameEdge}" Background="{DynamicResource FrameSurface}" Padding="5,2,5,5">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel x:Name="FrameTitle" Height="29" LastChildFill="True" Margin="8,0,7,0">
        <Path DockPanel.Dock="Left" Fill="{DynamicResource FrameAccent}" Data="M 6 0 L 22 0 L 15 17 L 0 17 Z" Width="22" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <Image DockPanel.Dock="Right" Source="{DynamicResource FrameSlashes}" Width="32" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"/>
        <ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource FrameInk}" TextElement.FontSize="14" TextElement.FontWeight="Bold" VerticalAlignment="Center"/>
       </DockPanel>
       <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource FrameInnerEdge}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
       </Border>
      </Grid>
     </Border>
     <Path Data="M 0 0 L 15 0 L 0 15 Z" Fill="{DynamicResource Bg}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
     <Path Data="M 0 0 L 15 0 L 15 15 Z" Fill="{DynamicResource Bg}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
     <Path Data="M 0 0 L 15 15 L 0 15 Z" Fill="{DynamicResource Bg}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
     <Path Data="M 15 0 L 15 15 L 0 15 Z" Fill="{DynamicResource Bg}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Header" Value="{x:Null}"><Setter TargetName="FrameTitle" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ResearchNav" TargetType="Button" BasedOn="{StaticResource NavButton}">
   <Setter Property="MinHeight" Value="54"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Padding" Value="15,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="NavEdge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
     </Border>
     <Border x:Name="NavFocus" CornerRadius="3" BorderThickness="2" Margin="3" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavEdge" Property="BorderBrush" Value="{DynamicResource SidebarMuted}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavEdge" Property="Opacity" Value=".78"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavFocus" Property="BorderBrush" Value="{DynamicResource FocusOnDark}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavEdge" Property="Opacity" Value=".52"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="SkinItemLabel">
   <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
  </DataTemplate>
  <Style x:Key="SidebarSkin" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="MinHeight" Value="49"/><Setter Property="Padding" Value="8,24,17,4"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Background" Value="{DynamicResource Sidebar}"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SidebarLine}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusOnDark}"/></Trigger>
    <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusOnDark}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="29"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Background" Value="{DynamicResource ChromeButtonSurface}"/><Setter Property="Foreground" Value="{DynamicResource ChromeInk}"/><Setter Property="BorderBrush" Value="{DynamicResource ChromeButtonEdge}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ChromeButtonHover}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ResearchMetric" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource MetricSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource MetricEdge}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="11,6"/>
   <Setter Property="Margin" Value="4,0"/>
  </Style>
  <Style x:Key="ResearchCurrentMetric" TargetType="Border" BasedOn="{StaticResource ResearchMetric}">
   <Setter Property="BorderBrush" Value="{DynamicResource MetricHighlight}"/>
   <Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="15,6,10,6"/>
  </Style>
  <Style x:Key="ResearchMetricLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MetricInk}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="ResearchReadout" TargetType="TextBlock" BasedOn="{StaticResource Readout}">
   <Setter Property="Foreground" Value="{DynamicResource MetricInk}"/><Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/><Setter Property="FontSize" Value="27"/>
  </Style>
 </Window.Resources>
 <Border x:Name="WindowSurface" Background="{DynamicResource Bg}">
 <Grid x:Name="ContentRoot">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource ShellBackdrop}" IsHitTestVisible="False"/>
  <Grid x:Name="HeaderArtwork" Grid.ColumnSpan="2" Grid.RowSpan="2" Height="108" VerticalAlignment="Top" IsHitTestVisible="False">
   <Image Source="Assets/LoneTrail/orbital-header-banner.png" Stretch="UniformToFill" VerticalAlignment="Center" ClipToBounds="True"/>
   <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFFFF" Offset=".55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Grid.OpacityMask>
  </Grid>

  <Border x:Name="BabelTitlebarSurface" Grid.ColumnSpan="2" Background="{DynamicResource BabelTitlebarBackground}"
          BorderBrush="{DynamicResource BabelTitlebarEdge}" BorderThickness="0,0,0,1"
          Visibility="Collapsed" IsHitTestVisible="False"/>

  <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="DragTitleBar">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="BrandBadge" Width="202" Margin="5,3,0,3" Background="{DynamicResource ChromeBrandSurface}">
    <StackPanel x:Name="BrandMark" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Image Source="Assets/LoneTrail/arkdps-icon.png" Width="34" Height="24" Margin="0,0,5,0"/>
     <TextBlock Text="ArkDPS" Foreground="#F3F5F7" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
    <Image x:Name="CompactBrandMark" Source="Assets/LoneTrail/arkdps-icon.png" Width="34" HorizontalAlignment="Center" Stretch="Uniform" Visibility="Collapsed"/>
    <Image x:Name="PeopleBrandMark" Source="{DynamicResource PeopleMasthead}" Width="132" Height="30" Stretch="Uniform" Visibility="Collapsed"/>
    <Image x:Name="PeopleCompactBrandMark" Source="{DynamicResource PeopleEmblem}" Width="38" Height="27" Stretch="Uniform" Visibility="Collapsed"/>
    <Image x:Name="BabelBrandMark" Source="{DynamicResource BabelMasthead}" Width="138" Height="30"
           Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Image x:Name="BabelCompactBrandMark" Source="{DynamicResource BabelEmblem}" Width="30" Height="28"
           Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
   <StackPanel Grid.Column="1" x:Name="ChromeDescription" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource ChromeDescriptionSurface}" Margin="5,0,0,0">
    <TextBlock x:Name="SystemTitle" Text="COMBAT DPS ANALYSIS SYSTEM" FontFamily="{DynamicResource DataFont}" FontSize="11" Foreground="{DynamicResource ChromeInk}" Margin="9,1,12,0"/>
    <TextBlock x:Name="ModeLabel" Text="ARKDPS / ORBITAL CONSOLE" FontFamily="{DynamicResource DataFont}" FontSize="10" Foreground="{DynamicResource ChromeMuted}" Margin="9,0,12,1"/>
   </StackPanel>
   <StackPanel x:Name="ChromeControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Background="{DynamicResource ChromeControlsSurface}" Margin="4,0,8,0">
    <Button x:Name="UpdateDownload" Content="发现新版本 · 查看下载" Click="OpenReleaseDownload" Visibility="Collapsed"
            AutomationProperties.Name="查看新版本下载" Padding="8,3" Margin="0,0,8,0"/>
    <StackPanel x:Name="ChromeLab" Margin="4,0,13,0" VerticalAlignment="Center">
     <TextBlock Text="ORBITAL COMBAT RESEARCH UNIT" FontFamily="{DynamicResource DataFont}" FontSize="11" Foreground="{DynamicResource ChromeInk}"/>
     <TextBlock Text="ORCU / DPS LAB" FontFamily="{DynamicResource DataFont}" FontSize="10" Foreground="{DynamicResource ChromeMuted}" Margin="0,2,0,0"/>
    </StackPanel>
    <Button Click="MinimizeWindow" Style="{StaticResource ChromeButton}" AutomationProperties.Name="最小化"><Path Data="M 0 5 H 10" Stroke="{DynamicResource ChromeInk}" StrokeThickness="1.2"/></Button>
    <Button Click="ToggleMaximizeWindow" Style="{StaticResource ChromeButton}" AutomationProperties.Name="最大化或还原"><Path Data="M 0 0 H 9 V 9 H 0 Z" Stroke="{DynamicResource ChromeInk}" StrokeThickness="1.2"/></Button>
    <Button Click="QuitClick" Style="{StaticResource ChromeButton}" AutomationProperties.Name="退出 ArkDPS"><Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="{DynamicResource ChromeInk}" StrokeThickness="1.2"/></Button>
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource ShellSidebarEdge}" BorderThickness="0,1,1,1" Margin="7,0,0,7" ClipToBounds="True">
   <Grid>
    <Border Background="{DynamicResource ShellSidebarArtwork}" IsHitTestVisible="False"/>
    <Border Background="{DynamicResource ShellSidebarShade}" IsHitTestVisible="False"/>
    <DockPanel>
     <StackPanel x:Name="SidebarNavigation" DockPanel.Dock="Top" Margin="3,8,3,0">
     <Button x:Name="LiveNav" Tag="live" Click="Navigate" Style="{StaticResource ResearchNav}" ToolTip="实时战况" AutomationProperties.Name="实时战况">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Image x:Name="LiveNavAsset" Source="{DynamicResource ShellLiveNavIcon}" Width="25" Height="24" Stretch="Uniform"/>
       <TextBlock x:Name="LiveNavLabel" Text="实时战况" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button x:Name="EnemyNav" Tag="enemies" Click="Navigate" Style="{StaticResource ResearchNav}" ToolTip="敌情" AutomationProperties.Name="敌情">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Image x:Name="EnemyNavAsset" Source="{DynamicResource ShellEnemyNavIcon}" Width="25" Height="24" Stretch="Uniform"/>
       <TextBlock x:Name="EnemyNavLabel" Text="敌情" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button x:Name="HistoryNav" Tag="history" Click="Navigate" Style="{StaticResource ResearchNav}" ToolTip="历史战绩" AutomationProperties.Name="历史战绩">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Image x:Name="HistoryNavAsset" Source="{DynamicResource ShellHistoryNavIcon}" Width="25" Height="24" Stretch="Uniform"/>
       <TextBlock x:Name="HistoryNavLabel" Text="历史战绩" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button x:Name="SettingsNav" Tag="settings" Click="Navigate" Style="{StaticResource ResearchNav}" ToolTip="设置" AutomationProperties.Name="设置">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Image x:Name="SettingsNavAsset" Source="{DynamicResource ShellSettingsNavIcon}" Width="25" Height="24" Stretch="Uniform"/>
       <TextBlock x:Name="SettingsNavLabel" Text="设置" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>


     </StackPanel>
     <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="3,0,3,10">
      <TextBlock x:Name="SideLab" Text="ORCU" Foreground="#DCE5ED" FontSize="21" FontWeight="Bold" Margin="8,0,0,2"/>
      <TextBlock x:Name="SideLabName" Text="ORBITAL COMBAT&#x0a;RESEARCH UNIT" Foreground="#DCE5ED" FontSize="11" FontFamily="{DynamicResource DataFont}" Margin="8,0,0,10"/>
      <Image x:Name="PeoplePennant" Source="{DynamicResource PeoplePennantArtwork}" Width="34" Height="43"
             HorizontalAlignment="Left" Margin="8,0,0,7" IsHitTestVisible="False" Visibility="Collapsed"/>
      <Image x:Name="BabelSidebarMark" Source="{DynamicResource BabelTowerBadge}" Width="48" Height="51"
             HorizontalAlignment="Left" Margin="8,0,0,7" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed"/>
      <Grid>
       <ComboBox x:Name="Skin" SelectionChanged="SkinChanged" Style="{StaticResource SidebarSkin}" AutomationProperties.Name="皮肤" ToolTip="切换皮肤">
        <ComboBoxItem Content="孤星" Tag="lone-trail" ContentTemplate="{StaticResource SkinItemLabel}"/>
        <ComboBoxItem Content="人们，我们。" Tag="people" ContentTemplate="{StaticResource SkinItemLabel}"/>
        <ComboBoxItem Content="巴别塔" Tag="babel" ContentTemplate="{StaticResource SkinItemLabel}"/>
       </ComboBox>
       <TextBlock x:Name="SkinLabel" Text="皮肤" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarMuted}"
                  VerticalAlignment="Top" Margin="8,6,17,0" IsHitTestVisible="False"/>
      </Grid>
     </StackPanel>
     <Border/>
    </DockPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" Grid.Column="1" Background="Transparent">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="SubpageHeader" Visibility="Collapsed" Grid.Row="0" Margin="12,13,12,8">
    <Button x:Name="SubpageReconnectButton" Content="重连观察者" DockPanel.Dock="Right" Click="Rescan" Padding="11,7" VerticalAlignment="Center"/>
    <Border HorizontalAlignment="Left" Background="{DynamicResource SubpageHeadingSurface}" Padding="{DynamicResource SubpageHeadingPadding}">
     <StackPanel>
      <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Foreground="{DynamicResource HeroInk}" FontSize="25" Text="实时战况"/>
      <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource HeroMuted}" FontSize="12"/>
     </StackPanel>
    </Border>
   </DockPanel>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="LivePage" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="5,4,3,4">
     <Grid Margin="0,0,4,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <HeaderedContentControl x:Name="LiveOverviewFrame" Style="{StaticResource ResearchFrame}" Padding="22,7,14,5" Margin="0,0,0,5" MinHeight="304">
       <HeaderedContentControl.Header>
        <DockPanel>
         <DockPanel x:Name="StatusBadge" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
          <Ellipse x:Name="StatusLight" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0"
                   VerticalAlignment="Center" Fill="#777B80" IsHitTestVisible="False"/>
          <TextBlock x:Name="Status" Text="等待连接观察者" Foreground="{DynamicResource FrameMuted}" FontSize="12"
                     TextTrimming="CharacterEllipsis" MaxWidth="224" VerticalAlignment="Center"/>
         </DockPanel>
         <TextBlock x:Name="LiveFrameTitle" Text="实时DPS / LIVE DPS" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource FrameInk}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
       </HeaderedContentControl.Header>
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="OverviewGrid">
         <Grid.ColumnDefinitions><ColumnDefinition x:Name="OverviewTrendColumn" Width="1.69*"/><ColumnDefinition x:Name="OverviewStatsColumn" Width="4*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid x:Name="BabelMastheadSurface" Grid.ColumnSpan="2" Height="145" Visibility="Collapsed"
               Background="{DynamicResource BabelPaper}" ClipToBounds="True" IsHitTestVisible="False">
          <Image x:Name="BabelMastheadArtwork" Source="{DynamicResource BabelMastheadArt}"
                 Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          <Border x:Name="BabelMastheadVeilLayer" Background="{DynamicResource BabelMastheadVeil}"/>
          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="32" Height="2"
                  Background="{DynamicResource BabelPaperAccent}"/>
         </Grid>
         <StackPanel x:Name="BabelMastheadHeading" Visibility="Collapsed" VerticalAlignment="Center" Margin="22,0,8,0">
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
           <TextBlock x:Name="BabelMastheadTitle" Text="观察停止" FontFamily="{DynamicResource HeadingFont}"
                      FontSize="72" FontWeight="Bold" LineHeight="72" LineStackingStrategy="BlockLineHeight"
                      Foreground="{DynamicResource BabelPaperInk}"/>
          </Viewbox>
          <DockPanel x:Name="BabelMastheadSubtitle" Margin="2,4,0,0">
           <Path DockPanel.Dock="Left" Data="M 0,4 L 4,0 L 8,4 L 4,8 Z" Width="8" Height="8" Stretch="Fill"
                 Fill="{DynamicResource BabelPaperAccent}" Margin="0,0,7,0" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>
           <TextBlock x:Name="BabelMastheadStageCode" Text="等待进入战斗" FontSize="14" FontWeight="SemiBold"
                      Foreground="{DynamicResource BabelPaperMuted}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
         </StackPanel>
         <Border x:Name="BabelMetricStrip" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                 Background="{DynamicResource Inset}" IsHitTestVisible="False"/>
         <Border x:Name="CurrentMetric" Style="{StaticResource ResearchCurrentMetric}">
          <StackPanel>
           <TextBlock x:Name="CurrentMetricLabel" Text="当前团队DPS" Style="{StaticResource ResearchMetricLabel}"/>
           <DockPanel>
            <Path x:Name="CurrentMetricPulse" DockPanel.Dock="Left" Data="M 0 11 H 7 L 10 5 L 14 17 L 19 0 L 23 13 L 26 7 L 29 11 H 36" Stroke="{DynamicResource MetricSignal}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,2,9,0"/>
            <TextBlock x:Name="CurrentMetricUnit" Text="DPS" Foreground="{DynamicResource MetricMuted}" FontSize="15" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
            <TextBlock x:Name="CurrentDps" Text="—" Style="{StaticResource ResearchReadout}" FontSize="39"/>
           </DockPanel>
          </StackPanel>
         </Border>
         <UniformGrid x:Name="MetricCards" Grid.Column="1" Columns="4">
          <Border Style="{StaticResource ResearchMetric}"><StackPanel><TextBlock Text="∑   平均DPS" Style="{StaticResource ResearchMetricLabel}"/><TextBlock x:Name="AverageDps" Text="—" Style="{StaticResource ResearchReadout}"/></StackPanel></Border>
          <Border Style="{StaticResource ResearchMetric}"><StackPanel><TextBlock Text="峰值DPS（观察）" Style="{StaticResource ResearchMetricLabel}"/><TextBlock x:Name="PeakDps" Text="—" Style="{StaticResource ResearchReadout}"/></StackPanel></Border>
          <Border Style="{StaticResource ResearchMetric}"><StackPanel><TextBlock Text="战斗时间" Style="{StaticResource ResearchMetricLabel}"/><TextBlock x:Name="Clock" Text="—" Style="{StaticResource ResearchReadout}"/></StackPanel></Border>
          <Border Style="{StaticResource ResearchMetric}"><StackPanel><TextBlock Text="总伤" Style="{StaticResource ResearchMetricLabel}"/><TextBlock x:Name="TotalDamage" Text="—" Style="{StaticResource ResearchReadout}"/></StackPanel></Border>
         </UniformGrid>
        </Grid>
        <local:LiveTrendView Grid.Row="1" x:Name="CompactTrend" Kind="Compact" Margin="4,4,4,0"/>
        <WrapPanel Grid.Row="2" Margin="4,1,4,0" Visibility="Collapsed">
         <TextBlock x:Name="Stage"/><TextBlock x:Name="EventStatus"/><TextBlock x:Name="ErrorText"/>
        </WrapPanel>
       </Grid>
      </HeaderedContentControl>
      <Grid x:Name="LiveBody" Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition x:Name="EnemySummaryColumn" Width="22*"/><ColumnDefinition x:Name="RankingColumn" Width="41*"/><ColumnDefinition x:Name="DetailColumn" Width="37*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition x:Name="LiveBodyFirstRow" Height="*"/><RowDefinition x:Name="LiveBodySecondRow" Height="0"/><RowDefinition x:Name="LiveBodyThirdRow" Height="0"/></Grid.RowDefinitions>
       <HeaderedContentControl x:Name="EnemySummary" Header="敌方单位 / ENEMY UNIT" Style="{StaticResource ResearchFrame}" Padding="4" Margin="0,0,5,0">
        <local:LiveTargetSummary x:Name="TargetSummary"/>
       </HeaderedContentControl>
       <HeaderedContentControl x:Name="RankingFrame" Grid.Column="1" Header="干员DPS排行 / OPERATOR DPS RANKING" Style="{StaticResource ResearchFrame}" Padding="3" Margin="0,0,5,0">
        <DockPanel>
         <WrapPanel x:Name="RankingFooter" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,2,0,0">
          <StackPanel x:Name="HudFooterControls" Orientation="Horizontal" Margin="0,0,6,0" Visibility="Collapsed">
           <ComboBox x:Name="HudFooterTarget" Width="62" MinHeight="22" FontSize="11" Padding="5,2,22,2"
                     SelectedValuePath="Id" DisplayMemberPath="Label"
                     AutomationProperties.Name="要调整的 HUD" ToolTip="选择要调整的 HUD"
                     SelectionChanged="HudFooterSelectionChanged" Visibility="Collapsed"/>
           <Button x:Name="HudFooterLock" Content="锁定 HUD" Click="ToggleFooterHudLock" Padding="6,1" MinHeight="22" FontSize="11"/>
           <TextBlock Text="透明度" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
           <Slider x:Name="HudFooterOpacity" Minimum="0" Maximum="100" Value="10" Width="55" TickFrequency="1"
                   IsSnapToTickEnabled="True" ValueChanged="FooterHudOpacityChanged" VerticalAlignment="Center"
                   AutomationProperties.Name="HUD 透明度"/>
           <TextBlock Text="{Binding Value, ElementName=HudFooterOpacity, StringFormat={}{0:0}%}"
                      Foreground="{DynamicResource Muted}" Width="31" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
          </StackPanel>
          <Button x:Name="AddPanelButton" Content="+ 新建面板" Click="AddPanel" Padding="6,1" MinHeight="22" FontSize="11"/>
          <Button x:Name="LiveReconnectButton" Content="重连观察者" Click="Rescan" Padding="6,1" MinHeight="22" FontSize="11"/>
         </WrapPanel>
         <ScrollViewer x:Name="RankingScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PanelHost"/>
         </ScrollViewer>
        </DockPanel>
       </HeaderedContentControl>
       <HeaderedContentControl x:Name="LiveDetail" Grid.Column="2" Header="干员详情 / OPERATOR DETAIL" Style="{StaticResource ResearchFrame}" Padding="2">
        <ScrollViewer x:Name="LiveDetailScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
         <StackPanel><local:Inspector x:Name="LiveInspector" CompactReference="True"/>
          <local:LiveTrendView x:Name="OperatorTrend" Kind="Operator" Margin="0,3,0,0" Visibility="Collapsed"/>
         </StackPanel>
        </ScrollViewer>
       </HeaderedContentControl>
      </Grid>
     </Grid>
    </ScrollViewer>

    <Grid x:Name="HistoryPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryListColumn" Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="HistoryListRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="HistoryListBorder" Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="28,0,14,18" Padding="14">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,8">
         <Button x:Name="HistoryRefreshButton" Content="刷新" Click="RefreshHistory" DockPanel.Dock="Right" Padding="10,6" Margin="6,0,0,0"/>
         <TextBox x:Name="Search" TextChanged="FilterHistory" AutomationProperties.Name="搜索最近 100 局" ToolTip="搜索关卡、干员或日期"/>
        </DockPanel>
        <WrapPanel Margin="0,0,0,8">
         <ComboBox x:Name="Outcome" Width="102" SelectionChanged="FilterHistory"><ComboBoxItem Content="全部结果"/><ComboBoxItem Content="胜利"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="退出"/><ComboBoxItem Content="结果未知"/></ComboBox>
         <ComboBox x:Name="Practice" Width="104" SelectionChanged="FilterHistory"><ComboBoxItem Content="全部模式"/><ComboBoxItem Content="演习"/><ComboBoxItem Content="正式"/><ComboBoxItem Content="演习状态未知"/></ComboBox>
        </WrapPanel>
       </StackPanel>
       <ListBox x:Name="HistoryList" SelectionChanged="SelectHistory">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Border Padding="8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding StageDescription}">
           <StackPanel>
            <TextBlock Text="{Binding Stage}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
           </StackPanel>
          </Border>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Border>
     <DockPanel x:Name="HistoryDetailHost" Grid.Row="1" Grid.Column="1" Margin="0,0,24,18">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,4,10">
       <WrapPanel><Button Content="收起 / 展开列表" Click="ToggleHistoryList" Padding="10,6"/><Button x:Name="ExportJson" Content="导出 JSON" Click="SaveJson" IsEnabled="False" Padding="10,6"/><Button x:Name="ExportPng" Content="完整排行 PNG" Click="SavePng" IsEnabled="False" Style="{StaticResource Primary}" Padding="12,6"/></WrapPanel>
       <TextBlock x:Name="HistorySummary" Text="暂无可读战绩；完成对局归档后自动出现。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock x:Name="HistoryNotice" Foreground="{DynamicResource Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel><local:StatisticPanel x:Name="HistoryPanel" Margin="0,0,0,12"/><local:Inspector x:Name="HistoryInspector"/></StackPanel></ScrollViewer>
     </DockPanel>
    </Grid>

    <ScrollViewer x:Name="EnemyPageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,0">
    <Grid x:Name="EnemyPage" Margin="0,0,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <UniformGrid x:Name="EnemyMetrics" Columns="4" Margin="0,0,0,8">
      <Border Style="{StaticResource MetricCard}" Grid.Column="0" Margin="0,0,8,0"><StackPanel><TextBlock Text="已入场敌人" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyEntered" Text="—" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="含已离场实例" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="1" Margin="0,0,8,0"><StackPanel><TextBlock Text="已入场总血量" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyTotalHp" Text="—" Foreground="{DynamicResource Accent}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="随入场和重生累计" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="2" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="EnemyOurDamageLabel" Text="我方有效伤害" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyOurDamage" Text="—" Foreground="{DynamicResource Good}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="干员与归属召唤物" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="3" Margin="0"><StackPanel><TextBlock Text="敌方剩余" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyRemaining" Text="—" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="仅场上存活实例" Style="{StaticResource Caption}"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition x:Name="EnemyChartColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="EnemyRosterRow" Height="*"/><RowDefinition x:Name="EnemyChartRow" Height="0"/></Grid.RowDefinitions>
      <Border x:Name="EnemyRosterHost" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,12,0">
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="已入场敌人" DockPanel.Dock="Left" Style="{StaticResource CardTitle}" FontSize="18"/><TextBlock x:Name="EnemyStatusText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom"/></DockPanel>
        <TextBlock x:Name="EnemyStatusHint" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Grid>
         <ListBox x:Name="EnemyList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已入场敌人">
          <ListBox.ItemTemplate><DataTemplate><Border Padding="8,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding Tooltip}"><StackPanel>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Badge}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Stretch="UniformToFill"/></Grid></Border>
            <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Eid}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource DataFont}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="10" TextAlignment="Right"/><TextBlock Text="{Binding HpText}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource DataFont}" FontSize="12" TextAlignment="Right" Margin="0,2,0,0"/></StackPanel>
           </Grid>
           <ProgressBar Value="{Binding HpPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,7,0,5" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0">
            <ProgressBar.Style>
             <Style TargetType="ProgressBar">
              <Style.Triggers>
               <DataTrigger Binding="{Binding HpPercentKnown}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </ProgressBar.Style>
           </ProgressBar>
           <TextBlock Text="{Binding PhaseHpText}" Foreground="{DynamicResource Ink}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Style.Triggers>
               <DataTrigger Binding="{Binding PhaseHpText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding AttrsText}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <TextBlock x:Name="EnemyEmpty" Text="场上暂无已入场敌人。" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="300" Visibility="Collapsed"/>
        </Grid>
       </DockPanel>
      </Border>
      <Border x:Name="EnemyChartHost" Style="{StaticResource SurfaceCard}" Grid.Column="1" Padding="12">
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="血量 / 有效伤害" DockPanel.Dock="Left" Style="{StaticResource CardTitle}" FontSize="18"/><TextBlock Text="按游戏时间" Foreground="{DynamicResource Muted}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Bottom"/></DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Accent}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendTotal" Text="已入场总血量" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,12,0"/>
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Good}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendDamage" Text="我方有效伤害" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,12,0"/>
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Muted}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendRemaining" Text="敌方剩余" Foreground="{DynamicResource Muted}" FontSize="10"/>
        </WrapPanel>
        <local:EnemyChart x:Name="EnemyChart"/>
       </DockPanel>
      </Border>
     </Grid>
    </Grid>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,0">
     <Grid MaxWidth="1080">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsRightColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.ColumnSpan="2" Style="{StaticResource SurfaceCard}" Padding="20,12" Margin="0,0,0,12">
       <StackPanel>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="数值缩写单位" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
         <ComboBox x:Name="NumberUnits" AutomationProperties.Name="数值缩写单位" SelectionChanged="NumberUnitsChanged" MinWidth="150">
          <ComboBoxItem Content="K / M" Tag="western"/>
          <ComboBoxItem Content="万 / 亿" Tag="chinese"/>
         </ComboBox>
        </StackPanel>
        <WrapPanel Margin="0,8,0,0">
         <TextBlock Text="HUD 布局" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
         <ComboBox x:Name="HudLayoutTarget" AutomationProperties.Name="HUD 源面板" DisplayMemberPath="Label" Width="186"/>
         <Button x:Name="EditHudLayoutButton" Content="调整布局" Click="EditHudLayoutClick" Margin="0" IsEnabled="False"/>
        </WrapPanel>
        <WrapPanel x:Name="ReleaseSettings" Visibility="Collapsed" Margin="0,8,0,0">
         <TextBlock x:Name="InstalledVersion" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
         <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateClick" Margin="0,0,12,0"/>
         <TextBlock x:Name="UpdateStatus" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <Border x:Name="ConnectionForm" Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,12,12">
       <StackPanel>
        <TextBlock Text="连接到 MuMu" Style="{StaticResource CardTitle}" FontSize="20"/>
        <TextBlock Text="UI 不访问游戏进程和 ADB；连接与只读采集由独立 Python 进程负责。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,14"/>
        <CheckBox x:Name="AutoDetect" Content="自动检测认证的 MuMu 实例（多实例时需明确选择）"/>
        <TextBlock Text="ADB 路径 · 留空自动查找" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/><TextBox x:Name="AdbPath" AutomationProperties.Name="ADB 路径"/>
        <TextBlock Text="实例地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/><TextBox x:Name="Serial" ToolTip="多实例时选择检测结果或输入地址；明确地址不会被自动替换" AutomationProperties.Name="实例地址"/>
        <Button x:Name="DetectButton" Content="检测实例" Click="Detect" HorizontalAlignment="Left" Margin="0,12,0,8"/>
        <ListBox x:Name="Instances" MinHeight="46" MaxHeight="140" SelectionChanged="ChooseInstance"/>
        <TextBlock x:Name="DetectionNote" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <Border x:Name="ConnectionEventForm" Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12">
       <StackPanel><TextBlock Text="观察者与连接诊断" Style="{StaticResource CardTitle}" FontSize="20"/>
        <CheckBox x:Name="EventsEnabled" Content="启用观察者"/>
        <TextBlock Text="连接后，可按游戏事件统计有效伤害、伤害溢出、被减伤率、技能期伤害与覆盖率、接敌 DPS 和护盾实际吸收，并追踪敌人入场、血量变化、重生与离场。"
                   Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="关闭或连接失败时，继续使用伤害与治疗累计快照。事件未覆盖的统计显示为未知。"
                   Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="ConnectionDiagnostics" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        <Button Content="应用设置并重连" Click="ApplySettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
    </ScrollViewer>
   </Grid>

   <TextBlock x:Name="Footer" Grid.Row="2" Visibility="Collapsed"/>
  </Grid>
 </Grid>
 </Border>
</Window>
