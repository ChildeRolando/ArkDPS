<Window x:Class="ArkDPS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArkDPS.Desktop"
 Style="{StaticResource {x:Type Window}}" Title="ArkDPS · 局内统计" Width="1380" Height="900" MinWidth="560" MinHeight="540" Closing="OnClosing" SizeChanged="OnResize"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Background="{DynamicResource Bg}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,0,1,0">
   <Grid ClipToBounds="True">
    <Image x:Name="SidebarArtwork" Source="Assets/LoneTrail/sidebar-orbital-detail.png" Stretch="UniformToFill" VerticalAlignment="Stretch" Opacity=".28" IsHitTestVisible="False"/>
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="10,0">
      <Grid Height="80">
       <Image x:Name="BrandMark" Source="Assets/LoneTrail/arkdps-logo-white.png" Width="130" Stretch="Uniform" HorizontalAlignment="Center" ToolTip="ArkDPS"/>
       <Image x:Name="CompactBrandMark" Source="Assets/LoneTrail/arkdps-icon.png" Width="42" Stretch="Uniform" HorizontalAlignment="Center" Visibility="Collapsed" ToolTip="ArkDPS"/>
       <TextBlock x:Name="BrandText" Text="ArkDPS" Foreground="{DynamicResource SidebarInk}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
      <Button x:Name="LiveNav" Tag="live" Click="Navigate" Style="{StaticResource NavButton}" ToolTip="实时战况" AutomationProperties.Name="实时战况">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="LiveNavAsset" Width="22" Height="22" Background="#D6DEE6" CornerRadius="3">
         <Image Source="Assets/LoneTrail/realtime.png" Width="16" Height="16" Stretch="Uniform"/>
        </Border>
        <Path x:Name="LiveNavVector" Width="19" Height="19" Data="M 1 15 L 5 15 L 5 10 L 1 10 Z M 7 15 L 11 15 L 11 6 L 7 6 Z M 13 15 L 17 15 L 17 2 L 13 2 Z" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
        <TextBlock x:Name="LiveNavLabel" Text="实时战况" Margin="10,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button x:Name="HistoryNav" Tag="history" Click="Navigate" Style="{StaticResource NavButton}" ToolTip="历史战绩" AutomationProperties.Name="历史战绩">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="HistoryNavAsset" Width="22" Height="22" Background="#D6DEE6" CornerRadius="3">
         <Image Source="Assets/LoneTrail/history.png" Width="16" Height="16" Stretch="Uniform"/>
        </Border>
        <Path x:Name="HistoryNavVector" Width="19" Height="19" Data="M 9 2 A 7 7 0 1 1 2 9 M 2 3 L 2 9 L 8 9 M 9 5 L 9 9 L 13 11" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
        <TextBlock x:Name="HistoryNavLabel" Text="历史战绩" Margin="10,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button x:Name="EnemyNav" Tag="enemies" Click="Navigate" Style="{StaticResource NavButton}" ToolTip="敌情" AutomationProperties.Name="敌情">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="EnemyNavAsset" Width="22" Height="22" Background="#D6DEE6" CornerRadius="3">
         <Image Source="Assets/LoneTrail/enemy.png" Width="16" Height="16" Stretch="Uniform"/>
        </Border>
        <Path x:Name="EnemyNavVector" Width="19" Height="19" Data="M 1 9 Q 9 -1 17 9 Q 9 19 1 9 Z M 12 9 A 3 3 0 1 1 6 9 A 3 3 0 1 1 12 9" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
        <TextBlock x:Name="EnemyNavLabel" Text="敌情" Margin="10,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button x:Name="SettingsNav" Tag="settings" Click="Navigate" Style="{StaticResource NavButton}" ToolTip="连接设置" AutomationProperties.Name="连接设置">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="SettingsNavAsset" Width="22" Height="22" Background="#D6DEE6" CornerRadius="3">
         <Image Source="Assets/LoneTrail/connection.png" Width="16" Height="16" Stretch="Uniform"/>
        </Border>
        <Path x:Name="SettingsNavVector" Width="19" Height="19" Data="M 2 4 H 16 M 2 9 H 16 M 2 14 H 16 M 6 2 V 6 M 12 7 V 11 M 8 12 V 16" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
        <TextBlock x:Name="SettingsNavLabel" Text="连接设置" Margin="10,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
     </StackPanel>

     <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
      <TextBlock Text="皮肤" Foreground="{DynamicResource SidebarMuted}" FontSize="11" Margin="2,0,0,5"/>
      <ComboBox x:Name="Skin" SelectionChanged="SkinChanged" AutomationProperties.Name="全局皮肤" Background="{DynamicResource SidebarCard}" Foreground="{DynamicResource SidebarInk}" BorderBrush="{DynamicResource SidebarLine}" Margin="0,0,0,8">
       <ComboBoxItem Content="孤星" Tag="lone-trail"/>
       <ComboBoxItem Content="危机合约" Tag="contingency-contract"/>
       <ComboBoxItem Content="巴别塔" Tag="babel"/>
       <ComboBoxItem Content="长夜临光" Tag="near-light"/>
       <ComboBoxItem Content="叙拉古人" Tag="il-siracusano"/>
       <ComboBoxItem Content="原始界面" Tag="original"/>
      </ComboBox>
      <Button Content="解锁 HUD" Click="UnlockAll" Background="{DynamicResource SidebarCard}" Foreground="{DynamicResource SidebarInk}" BorderBrush="{DynamicResource SidebarLine}" Padding="6,7" FontSize="11" Margin="0,0,0,6"/>
      <Button Content="退出" Click="QuitClick" Background="{DynamicResource Sidebar}" Foreground="{DynamicResource SidebarMuted}" BorderBrush="{DynamicResource SidebarLine}" Padding="6,7" FontSize="11" Margin="0"/>
     </StackPanel>
     <Border/>
    </DockPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Border Grid.Row="0" Height="68" Margin="20,14,20,10" Background="{DynamicResource Hero}" BorderBrush="{DynamicResource HeroLine}" BorderThickness="1" ClipToBounds="True">
    <Grid>
     <Grid x:Name="HeaderArtwork" Width="520" HorizontalAlignment="Right" IsHitTestVisible="False">
      <Image Source="Assets/LoneTrail/orbital-header-banner.png" Stretch="UniformToFill" Opacity=".64"/>
      <Grid.OpacityMask>
       <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset=".55"/></LinearGradientBrush>
      </Grid.OpacityMask>
     </Grid>
     <DockPanel Margin="16,11" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="AddPanelButton" Content="+ 新建面板" Click="AddPanel" Style="{StaticResource Primary}" Padding="11,7"/>
       <Button Content="重新定位" Click="Rescan" Padding="11,7"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
       <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Foreground="{DynamicResource HeroInk}" FontSize="26" LineHeight="30" Text="实时战况" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource HeroMuted}" FontSize="12" Text="团队输出与干员详情" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DockPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="1">
    <ScrollViewer x:Name="LivePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,12,0">
     <StackPanel Margin="0,0,8,12">
      <Border Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,0,12">
       <StackPanel>
        <WrapPanel Margin="0,0,0,5">
         <TextBlock x:Name="Stage" Text="关卡未知" Style="{StaticResource CardTitle}" Margin="0,0,12,0"/>
         <TextBlock x:Name="Clock" Text="游戏时间 —" Style="{StaticResource Mono}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,12,0"/>
         <TextBlock x:Name="Status" Text="等待战斗数据" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </WrapPanel>
        <TextBlock x:Name="EventStatus" Text="等待事件能力诊断" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="11"/>
        <Grid x:Name="OverviewGrid" Margin="0,8,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition x:Name="OverviewTrendColumn" Width="2*"/><ColumnDefinition x:Name="OverviewStatsColumn" Width="3*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel x:Name="CurrentMetric" Margin="0,0,12,0">
          <TextBlock Text="团队近 5 秒 DPS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
          <TextBlock x:Name="CurrentDps" Text="—" Style="{StaticResource Readout}" FontSize="38" Foreground="{DynamicResource DataHighlight}"/>
          <local:LiveTrendView x:Name="CompactTrend" Kind="Compact" Margin="0,4,0,0"/>
         </StackPanel>
         <UniformGrid x:Name="MetricCards" Grid.Column="1" Columns="5" Margin="0,4,0,0" VerticalAlignment="Center">
           <StackPanel Grid.Column="0" Margin="7,0">
            <TextBlock Text="本局平均 DPS" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="AverageDps" Text="—" Style="{StaticResource Readout}" Foreground="{DynamicResource Ink}"/>
           </StackPanel>
           <StackPanel Grid.Column="1" Margin="7,0">
            <TextBlock Text="观测峰值 DPS" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PeakDps" Text="—" Style="{StaticResource Readout}" Foreground="{DynamicResource Ink}"/>
           </StackPanel>
           <StackPanel Grid.Column="2" Margin="7,0">
            <TextBlock Text="累计伤害" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TotalDamage" Text="—" Style="{StaticResource Readout}" Foreground="{DynamicResource Ink}"/>
           </StackPanel>
           <StackPanel Grid.Column="3" Margin="7,0">
            <TextBlock Text="总治疗" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TotalHealing" Text="—" Style="{StaticResource Readout}" Foreground="{DynamicResource Heal}"/>
           </StackPanel>
           <StackPanel Grid.Column="4" Margin="7,0">
            <TextBlock Text="有效护盾" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TotalShield" Text="—" Style="{StaticResource Readout}" Foreground="{DynamicResource Shield}"/>
           </StackPanel>
         </UniformGrid>
        </Grid>
       </StackPanel>
      </Border>

      <Grid x:Name="LiveBody">
       <Grid.ColumnDefinitions><ColumnDefinition x:Name="EnemySummaryColumn" Width="0"/><ColumnDefinition x:Name="RankingColumn" Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="340"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="EnemySummary" Grid.ColumnSpan="3" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,0,12" VerticalAlignment="Top">
        <StackPanel>
         <DockPanel Margin="0,0,0,8">
          <Button Content="查看敌情" Tag="enemies" Click="Navigate" DockPanel.Dock="Right" Padding="7,3" Margin="0"/>
          <TextBlock Text="敌情" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
         </DockPanel>
         <WrapPanel>
          <StackPanel Margin="0,0,13,5"><TextBlock Text="已入场" Style="{StaticResource Caption}"/><TextBlock x:Name="LiveEnemyEntered" Text="—" Style="{StaticResource Readout}"/></StackPanel>
          <StackPanel Margin="0,0,13,5"><TextBlock Text="已入场总血量" Style="{StaticResource Caption}"/><TextBlock x:Name="LiveEnemyTotal" Text="—" Style="{StaticResource Readout}"/></StackPanel>
          <StackPanel Margin="0,0,0,5"><TextBlock Text="敌方剩余血量" Style="{StaticResource Caption}"/><TextBlock x:Name="LiveEnemyRemaining" Text="—" Style="{StaticResource Readout}"/></StackPanel>
         </WrapPanel>
         <TextBlock x:Name="LiveEnemyStatus" Text="等待战斗数据" Style="{StaticResource Caption}"/>
        </StackPanel>
       </Border>
       <WrapPanel x:Name="PanelHost" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top"/>
       <StackPanel x:Name="LiveDetail" Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
        <local:Inspector x:Name="LiveInspector"/>
        <local:LiveTrendView x:Name="OperatorTrend" Kind="Operator" Margin="0,8,0,0" Visibility="Collapsed"/>
       </StackPanel>
      </Grid>
      <local:LiveTrendView x:Name="BattleTrend" Kind="Timeline" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>

    <Grid x:Name="HistoryPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryListColumn" Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="HistoryListRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="HistoryListBorder" Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="28,0,14,18" Padding="14">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,8">
         <Button Content="刷新" Click="RefreshHistory" DockPanel.Dock="Right" Padding="10,6" Margin="6,0,0,0"/>
         <TextBox x:Name="Search" TextChanged="FilterHistory" AutomationProperties.Name="搜索最近 100 局" ToolTip="搜索关卡、干员或日期"/>
        </DockPanel>
        <WrapPanel Margin="0,0,0,8">
         <ComboBox x:Name="Outcome" Width="102" SelectionChanged="FilterHistory"><ComboBoxItem Content="全部结果"/><ComboBoxItem Content="胜利"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="退出"/><ComboBoxItem Content="结果未知"/></ComboBox>
         <ComboBox x:Name="Practice" Width="104" SelectionChanged="FilterHistory"><ComboBoxItem Content="全部模式"/><ComboBoxItem Content="演习"/><ComboBoxItem Content="正式"/><ComboBoxItem Content="演习状态未知"/></ComboBox>
        </WrapPanel>
       </StackPanel>
       <ListBox x:Name="HistoryList" SelectionChanged="SelectHistory">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Border Padding="8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding StageDetail}">
           <StackPanel>
            <TextBlock Text="{Binding Stage}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
           </StackPanel>
          </Border>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Border>
     <DockPanel x:Name="HistoryDetailHost" Grid.Row="1" Grid.Column="1" Margin="0,0,24,18">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,4,10">
       <WrapPanel><Button Content="收起 / 展开列表" Click="ToggleHistoryList" Padding="10,6"/><Button x:Name="ExportJson" Content="导出 JSON" Click="SaveJson" IsEnabled="False" Padding="10,6"/><Button x:Name="ExportPng" Content="完整排行 PNG" Click="SavePng" IsEnabled="False" Style="{StaticResource Primary}" Padding="12,6"/></WrapPanel>
       <TextBlock x:Name="HistorySummary" Text="暂无可读战绩；完成对局归档后自动出现。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/>
       <TextBlock x:Name="HistoryNotice" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><local:StatisticPanel x:Name="HistoryPanel" Margin="0,0,0,12"/><local:Inspector x:Name="HistoryInspector"/></StackPanel></ScrollViewer>
     </DockPanel>
    </Grid>

    <ScrollViewer x:Name="EnemyPageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,0">
    <Grid x:Name="EnemyPage" Margin="0,0,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <UniformGrid x:Name="EnemyMetrics" Columns="4" Margin="0,0,0,8">
      <Border Style="{StaticResource MetricCard}" Grid.Column="0" Margin="0,0,8,0"><StackPanel><TextBlock Text="已入场敌人" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyEntered" Text="—" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="含已离场实例" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="1" Margin="0,0,8,0"><StackPanel><TextBlock Text="已入场总血量" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyTotalHp" Text="—" Foreground="{DynamicResource Accent}" FontFamily="Cascadia Mono, Consolas" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="随入场和重生累计" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="2" Margin="0,0,8,0"><StackPanel><TextBlock Text="我方有效伤害" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyOurDamage" Text="—" Foreground="{DynamicResource Good}" FontFamily="Cascadia Mono, Consolas" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="干员与归属召唤物" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Grid.Column="3" Margin="0"><StackPanel><TextBlock Text="敌方剩余" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="EnemyRemaining" Text="—" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="27" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock Text="仅场上存活实例" Style="{StaticResource Caption}"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition x:Name="EnemyChartColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="EnemyRosterRow" Height="*"/><RowDefinition x:Name="EnemyChartRow" Height="0"/></Grid.RowDefinitions>
      <Border x:Name="EnemyRosterHost" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,12,0">
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="已入场敌人" DockPanel.Dock="Left" Style="{StaticResource CardTitle}" FontSize="18"/><TextBlock x:Name="EnemyStatusText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom"/></DockPanel>
        <TextBlock x:Name="EnemyStatusHint" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Grid>
         <ListBox x:Name="EnemyList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已入场敌人">
          <ListBox.ItemTemplate><DataTemplate><Border Padding="8,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding Tooltip}"><StackPanel>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Inset}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Badge}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Portrait}" Stretch="UniformToFill"/></Grid></Border>
            <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Eid}" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="10" TextAlignment="Right"/><TextBlock Text="{Binding HpText}" Foreground="{DynamicResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextAlignment="Right" Margin="0,2,0,0"/></StackPanel>
           </Grid>
           <ProgressBar Value="{Binding HpPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,7,0,5" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0">
            <ProgressBar.Style>
             <Style TargetType="ProgressBar">
              <Style.Triggers>
               <DataTrigger Binding="{Binding HpPercentKnown}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </ProgressBar.Style>
           </ProgressBar>
           <TextBlock Text="{Binding PhaseHpText}" Foreground="{DynamicResource Ink}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Style.Triggers>
               <DataTrigger Binding="{Binding PhaseHpText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding AttrsText}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <TextBlock x:Name="EnemyEmpty" Text="场上暂无已入场敌人。" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="300" Visibility="Collapsed"/>
        </Grid>
       </DockPanel>
      </Border>
      <Border x:Name="EnemyChartHost" Style="{StaticResource SurfaceCard}" Grid.Column="1" Padding="12">
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="血量 / 有效伤害" DockPanel.Dock="Left" Style="{StaticResource CardTitle}" FontSize="18"/><TextBlock Text="按游戏时间" Foreground="{DynamicResource Muted}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Bottom"/></DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Accent}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendTotal" Text="已入场总血量" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,12,0"/>
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Good}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendDamage" Text="我方有效伤害" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,12,0"/>
         <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Muted}" Margin="0,0,5,0"/><TextBlock x:Name="EnemyChartLegendRemaining" Text="敌方剩余" Foreground="{DynamicResource Muted}" FontSize="10"/>
        </WrapPanel>
        <local:EnemyChart x:Name="EnemyChart"/>
       </DockPanel>
      </Border>
     </Grid>
    </Grid>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,0">
     <Grid MaxWidth="1080">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsRightColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ConnectionForm" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,12,12">
       <StackPanel>
        <TextBlock Text="连接到 MuMu" Style="{StaticResource CardTitle}" FontSize="20"/>
        <TextBlock Text="UI 不访问游戏进程和 ADB；连接与只读采集由独立 Python 进程负责。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,14"/>
        <CheckBox x:Name="AutoDetect" Content="自动检测认证的 MuMu 实例（多实例时需明确选择）"/>
        <TextBlock Text="ADB 路径 · 留空自动查找" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/><TextBox x:Name="AdbPath" AutomationProperties.Name="ADB 路径"/>
        <TextBlock Text="实例地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/><TextBox x:Name="Serial" ToolTip="多实例时选择检测结果或输入地址；明确地址不会被自动替换" AutomationProperties.Name="实例地址"/>
        <Button x:Name="DetectButton" Content="检测实例" Click="Detect" HorizontalAlignment="Left" Margin="0,12,0,8"/>
        <ListBox x:Name="Instances" MinHeight="46" MaxHeight="140" SelectionChanged="ChooseInstance"/>
        <TextBlock x:Name="DetectionNote" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <Border x:Name="ConnectionEventForm" Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12">
       <StackPanel><TextBlock Text="事件观测与连接诊断" Style="{StaticResource CardTitle}" FontSize="20"/>
        <CheckBox x:Name="EventsEnabled" Content="启用事件观测 · 护盾实际吸收 / 独立接敌区间"/>
        <TextBlock Text="事件不可用时沿用伤害 / 治疗累计快照。覆盖前的护盾未知，不显示为零。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10"/>
        <TextBlock x:Name="ConnectionDiagnostics" Foreground="{DynamicResource Muted}" FontSize="12"/>
        <Button Content="应用设置并重新定位" Click="ApplySettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
    </ScrollViewer>
   </Grid>

   <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,8">
    <DockPanel><TextBlock x:Name="ModeLabel" Text="Windows / WPF · 只读采集" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="12,0,0,0"/>
     <TextBlock x:Name="Footer" Text="正在启动 Python 采集进程…" Foreground="{DynamicResource Muted}" FontSize="11"/>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
